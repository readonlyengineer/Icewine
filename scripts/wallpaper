#!/usr/bin/env bash

usage() {
    cat >&2 <<'EOF'
Usage: icewine wallpaper IMAGE

Select a local PNG, JPEG, GIF, or BMP wallpaper. Icewine stores a private copy
under XDG_DATA_HOME and updates the running desktop and handheld shell.
EOF
}

fail() {
    printf 'icewine wallpaper: %s\n' "$1" >&2
    exit 1
}

data_home=${ICEWINE_WALLPAPER_DATA_HOME:-${XDG_DATA_HOME:-"${HOME:?HOME is not set}/.local/share"}}
[[ $# == 1 ]] || { usage; exit 2; }
source_path=$1
[[ $data_home == /* ]] || fail 'XDG_DATA_HOME must be an absolute path'

[[ -f $source_path && -r $source_path ]] || fail 'image path is not a readable regular file'
source_path=$(realpath -- "$source_path") || fail 'could not resolve image path'

directory="$data_home/icewine/wallpapers"
selection="$directory/selection.img"
mkdir -p -- "$directory" || fail 'could not create the wallpaper data directory'

temporary=$(mktemp "$directory/selection.XXXXXXXX") || fail 'could not create a temporary wallpaper file'
cleanup() { rm -f -- "$temporary"; }
trap cleanup EXIT

cp -- "$source_path" "$temporary" || fail 'could not copy the wallpaper'

validation=$(ICEWINE_WALLPAPER_VALIDATE="$temporary" QT_QPA_PLATFORM=offscreen \
    timeout 20s qs --path "$ICEWINE_WALLPAPER_VALIDATOR" 2>&1) \
    || fail 'Qt could not decode the image; the saved wallpaper was left unchanged'
case $validation in
    *ICEWINE_WALLPAPER_VALID*) ;;
    *) fail 'Qt does not support this image; the saved wallpaper was left unchanged' ;;
esac

mv -fT -- "$temporary" "$selection" || fail 'could not save the wallpaper'
trap - EXIT

revision="$(date +%s%N)-$BASHPID"
if ! qs ipc call wallpaper refresh "$revision"; then
    printf 'icewine wallpaper: saved; the running Quickshell session did not refresh and will use it next launch\n' >&2
fi
