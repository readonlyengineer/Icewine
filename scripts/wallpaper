#!/usr/bin/env python3
"""Validate and atomically select the desktop wallpaper without changing its source."""
import fcntl
import importlib.machinery
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time
import types

theme = types.ModuleType("icewine_theme")
theme.__file__ = os.environ.get("ICEWINE_THEME_SCRIPT", str(Path(__file__).with_name("theme")))
importlib.machinery.SourceFileLoader(theme.__name__, theme.__file__).exec_module(theme)


def validate(path):
    validator = os.environ.get("ICEWINE_WALLPAPER_VALIDATOR")
    if not validator:
        raise ValueError("Icewine wallpaper validator is unavailable")
    result = subprocess.run(["qs", "-p", validator, "--no-color"],
        env=dict(os.environ, ICEWINE_WALLPAPER_VALIDATE=str(path), QT_QPA_PLATFORM="offscreen"),
        capture_output=True, text=True, timeout=20)
    if result.returncode or "ICEWINE_WALLPAPER_VALID" not in result.stdout + result.stderr:
        raise ValueError("Qt could not decode the image; saved wallpapers were left unchanged")


def select(args):
    if len(args) != 1 or args[0].startswith("--"):
        raise ValueError("Usage: icewine wallpaper IMAGE")
    data = Path(os.environ.get("ICEWINE_WALLPAPER_DATA_HOME")
        or os.environ.get("XDG_DATA_HOME") or (Path.home() / ".local/share"))
    if not data.is_absolute():
        raise ValueError("XDG_DATA_HOME must be an absolute path")
    source = Path(args[0]).resolve(strict=True)
    if not source.is_file():
        raise ValueError("image path is not a readable regular file")
    directory = data / "icewine/wallpapers"
    theme.setting_target(directory / "selection.img")
    theme.writable(directory / ".selection.lock")
    directory.mkdir(parents=True, exist_ok=True)
    fd = os.open(directory / ".selection.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "r+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        fd, name = tempfile.mkstemp(prefix=".wallpaper-", dir=directory)
        os.close(fd)
        temporary = Path(name)
        try:
            shutil.copyfile(source, temporary)
            temporary.chmod(0o600)
            validate(temporary)
            theme.setting_target(directory / "selection.img")
            theme.atomic_text(directory / "selection.img", temporary.read_bytes(), 0o600, setting=True)
        finally:
            temporary.unlink(missing_ok=True)
    try:
        result = subprocess.run(["qs", "ipc", "call", "wallpaper", "refresh", str(time.time_ns())],
                                capture_output=True, text=True, timeout=10)
        refreshed = result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        refreshed = False
    if not refreshed:
        print("icewine wallpaper: saved; the running shell will use it next launch", file=sys.stderr)


if __name__ == "__main__":
    try:
        select(sys.argv[1:])
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f"icewine wallpaper: {error}", file=sys.stderr)
        sys.exit(1)
