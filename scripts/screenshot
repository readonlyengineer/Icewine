set -euo pipefail

mode=${1:-region}
target=${2:-}
directory=$(xdg-user-dir PICTURES)
mkdir -p -- "$directory"
temporary=$(mktemp "$directory/.icewine-screenshot.XXXXXX")
trap 'rm -f -- "$temporary"' EXIT

case "$mode" in
  monitor)
    test -n "$target"
    grim -o "$target" "$temporary"
    ;;
  region)
    grimblast --freeze save area "$temporary"
    ;;
  window)
    test -n "$target"
    grim -T "$target" "$temporary"
    ;;
  *)
    echo "usage: icewine-screenshot {monitor OUTPUT|region|window STABLE_ID}" >&2
    exit 2
    ;;
esac

mv -f -- "$temporary" "$directory/screenshot.png"
wl-copy --type image/png < "$directory/screenshot.png"
notify-send "Screenshot Saved" "$directory/screenshot.png"
