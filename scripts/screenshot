set -euo pipefail

mode=${1:-region}
target=${2:-}
delay=${3:-0}
clipboard=${4:-1}
pictures=${5:-1}
case "$delay:$clipboard:$pictures" in
  [03]:[01]:[01]) ;;
  *) echo "invalid screenshot options" >&2; exit 2 ;;
esac
if [[ "$clipboard:$pictures" == 0:0 ]]; then
  echo "select at least one screenshot destination" >&2
  exit 2
fi
if [[ "$pictures" == 1 ]]; then
  directory=$(xdg-user-dir PICTURES)
  mkdir -p -- "$directory"
  temporary=$(mktemp "$directory/.icewine-screenshot.XXXXXX")
else
  temporary=$(mktemp "${TMPDIR:-/tmp}/icewine-screenshot.XXXXXX")
fi
trap 'rm -f -- "$temporary"' EXIT
if [[ "$delay" == 3 ]]; then sleep 3; fi

case "$mode" in
  monitor)
    test -n "$target"
    grim -o "$target" "$temporary"
    ;;
  region)
    grimblast --freeze save area "$temporary"
    ;;
  window)
    test -n "$target"
    grim -T "$target" "$temporary"
    ;;
  *)
    echo "usage: icewine-screenshot MODE TARGET [DELAY:0|3] [CLIPBOARD:0|1] [PICTURES:0|1]" >&2
    exit 2
    ;;
esac

capture=$temporary
destination="Clipboard"
if [[ "$pictures" == 1 ]]; then
  capture="$directory/screenshot.png"
  mv -f -- "$temporary" "$capture"
  destination=$capture
fi
if [[ "$clipboard" == 1 ]]; then
  wl-copy --type image/png < "$capture"
fi
notify-send "Screenshot Saved" "$destination"
