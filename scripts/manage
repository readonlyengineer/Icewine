#!/usr/bin/env python3
"""Backend for explicit manager Apply; deployment shares the theme helpers."""
import fcntl
import hashlib
import importlib.machinery
import json
import os
from pathlib import Path
import platform
import pwd
import re
import subprocess
import sys
import tempfile
import types

# Installed beside theme on Arch; Nix wrappers provide the source path.
theme = types.ModuleType("icewine_theme")
theme.__file__ = os.environ.get("ICEWINE_THEME_SCRIPT", str(Path(__file__).with_name("theme")))
importlib.machinery.SourceFileLoader(theme.__name__, theme.__file__).exec_module(theme)
FEATURES = ("desktop", "terminal", "filemanager", "steam", "gamescope", "handheld", "login", "shellExtras", "texteditor", "screenshot")
APPS = {
    "desktop": ("hypr", "uwsm", "gtk", "user-dirs", "applications"),
    "terminal": ("kitty",), "filemanager": ("yazi",),
    "steam": (), "gamescope": ("gamescope",), "handheld": (), "login": (),
    "shellExtras": ("starship", "fastfetch", "btop"), "texteditor": (), "screenshot": (),
}
PACKAGES = {
    "desktop": ("icewine-session",), "terminal": ("kitty",),
    "filemanager": ("yazi", "xdg-terminal-exec", "ffmpegthumbnailer", "7zip", "gvfs", "udisks2"),
    "steam": (), "gamescope": ("gamescope",), "handheld": ("icewine-handheld", "icewine-controller-idle", "inputplumber"),
    "login": (), "shellExtras": ("starship", "fastfetch"), "texteditor": ("neovim", "git", "gcc", "make", "ripgrep", "fd", "unzip"), "screenshot": (),
}


def validate(value, *, saved=False):
    original = value
    legacy = {"desktop", "terminal", "filemanager", "gaming", "flatpak", "login", "shellExtras"}
    if saved and isinstance(value, dict) and set(value) in (legacy, legacy | {"texteditor"}) and all(type(bit) is bool for bit in value.values()):
        value = {name: value[name] for name in legacy - {"gaming", "flatpak"}} | {
            "steam": ("flatpak" if value["flatpak"] else "native") if value["gaming"] else "none",
            "gamescope": value["gaming"], "handheld": False,
        }
    previous = set(FEATURES) - {"texteditor", "screenshot"}
    if saved and isinstance(value, dict) and set(value) == previous:
        value = value | {"texteditor": original.get("texteditor", False),
                         "screenshot": "advanced" if value["desktop"] else "none"}
    if (not isinstance(value, dict) or set(value) != set(FEATURES)
            or value["steam"] not in ("none", "native", "flatpak")
            or value["screenshot"] not in ("none", "simple", "advanced")
            or any(type(bit) is not bool for name, bit in value.items() if name not in {"steam", "screenshot"})):
        raise ValueError("invalid manager selections")
    if value["steam"] == "none" and (value["gamescope"] or value["handheld"]):
        raise ValueError("Gamescope and Handheld require Steam")
    if value["handheld"] and not (value["desktop"] and value["steam"] == "native" and value["gamescope"]):
        raise ValueError("Handheld requires desktop, native Steam and Gamescope")
    return value


def selections(state):
    declared = os.environ.get("ICEWINE_MANAGE_SELECTIONS")
    if declared is not None:
        return True, validate(json.loads(declared))
    if platform.freedesktop_os_release().get("ID") not in {"arch", "cachyos"}:
        raise ValueError("Icewine manager supports Arch/CachyOS or the NixOS module")
    path = state / "manage.json"
    saved = validate(json.loads(path.read_text()), saved=True) if path.exists() else dict.fromkeys(FEATURES, True) | {"steam": "flatpak", "handheld": False, "login": False, "screenshot": "advanced"}
    return theme.setting_readonly(path), saved | {"login": False}


WIDGETS = ("notificationToasts", "windowSwitcher", "cardStacks", "barBehaviour", "barLocation", "barStyle", "barWidth", "oskAccess")
BAR_CHOICES = {"barBehaviour": ("keyboard", "keyboard-mouse", "toggle", "always"),
               "barLocation": ("above", "top", "bottom"), "barStyle": ("anchored", "floating"),
               "oskAccess": ("none", "launcher", "topbar")}


def valid_widget(name, value):
    if name == "barWidth":
        return type(value) is int and 50 <= value <= 100
    if name == "cardStacks":
        return True  # Validated separately below, with the existing policy diagnostic.
    return value in BAR_CHOICES[name] if name in BAR_CHOICES else type(value) is bool


def widget_default(name):
    if name == "barWidth":
        return 80
    return BAR_CHOICES[name][0] if name in BAR_CHOICES else CARD_DEFAULTS if name == "cardStacks" else True
CARD_MODULES = ("launcher", "background", "layout", "media", "audio", "bluetooth",
                "clipboard", "network", "tailscale", "ssh", "notifications", "battery", "performance")
CARD_DEFAULTS = [{"id": names[0], "modules": list(names)} for names in (
    ("launcher", "background", "layout"), ("media",), ("audio", "bluetooth"),
    ("network", "tailscale", "ssh"), ("notifications", "clipboard"), ("battery", "performance"))]


def validate_stacks(stacks):
    if not isinstance(stacks, list):
        raise ValueError("invalid card stacks")
    ids, members = set(), set()
    for stack in stacks:
        if (not isinstance(stack, dict) or set(stack) != {"id", "modules"}
                or not isinstance(stack["id"], str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", stack["id"])
                or stack["id"] in ids or not isinstance(stack["modules"], list) or not stack["modules"]):
            raise ValueError("invalid card stack")
        ids.add(stack["id"])
        for name in stack["modules"]:
            if name not in CARD_MODULES or name in members:
                raise ValueError("invalid card module")
            members.add(name)
    return stacks


def stack_text(stacks):
    # IDs cannot contain these delimiters; keep the existing whitespace protocol.
    return ";".join(stack["id"] + "/" + ",".join(stack["modules"]) for stack in stacks)


def parse_stacks(text):
    stacks = []
    for entry in text.split(";") if text else []:
        name, separator, members = entry.partition("/")
        if not separator:
            raise ValueError("invalid card stack request")
        stacks.append({"id": name, "modules": members.split(",")})
    return validate_stacks(stacks)


def widget_state(config, state):
    policy = json.loads(os.environ.get("ICEWINE_WIDGET_POLICY", "{}"))
    if (not isinstance(policy, dict) or set(policy) - set(WIDGETS)
            or any(value is not None and not valid_widget(name, value) for name, value in policy.items())):
        raise ValueError("invalid widget policy; Widgets are read-only")
    if policy.get("cardStacks") is not None:
        try:
            validate_stacks(policy["cardStacks"])
        except ValueError as error:
            raise ValueError("invalid cardStacks policy; Widgets are read-only") from error
    path = state / "widgets.json"
    contents = path.read_bytes() if path.exists() else None
    saved = json.loads(contents) if contents is not None else {}
    revision = hashlib.sha256(contents or b"").hexdigest()
    if (not isinstance(saved, dict) or set(saved) - set(WIDGETS)
            or any(not valid_widget(name, value) for name, value in saved.items())):
        raise ValueError("invalid widget selections; repair widgets.json before saving")
    if "cardStacks" in saved:
        validate_stacks(saved["cardStacks"])
    settings = config / "quickshell/config/Settings.qml"
    # Custom settings remain editable; do not promise delivery through an
    # unknown implementation. Restore shipped settings to enable these controls.
    shipped = Path(os.environ.get("ICEWINE_WIDGET_SETTINGS",
        "/usr/share/icewine/defaults/config/quickshell/config/Settings.qml"))
    entries = os.environ.get("ICEWINE_WIDGET_SHELLS",
        "/usr/share/icewine/defaults/config/quickshell/shell.qml:"
        "/usr/share/icewine/defaults-handheld/config/quickshell/shell.qml").split(os.pathsep)
    entry = config / "quickshell/shell.qml"
    supported = (settings.is_file() and shipped.is_file() and settings.read_bytes() == shipped.read_bytes()
                 and entry.is_file() and any(Path(path).is_file() and entry.read_bytes() == Path(path).read_bytes()
                                            for path in entries))
    return saved, policy, supported, revision


def widgets(argv, config, state):
    saved, policy, supported, revision = widget_state(config, state)
    readonly = theme.setting_readonly(state / "widgets.json")
    if argv == ["widgets-state"]:
        print("supported=" + str(supported).lower(), "revision=" + revision, *[
            f"{name}={stack_text(value) if name == 'cardStacks' else str(value).lower()}:{'policy' if policy.get(name) is not None else 'readonly' if readonly else 'user'}"
            for name in WIDGETS
            for value in [policy[name] if policy.get(name) is not None else saved.get(name, widget_default(name))]])
        return
    theme.setting_target(state / "widgets.json")
    if len(argv) < 3 or argv[1] != "revision=" + revision:
        raise ValueError("Widget preferences changed; reopen the manager before saving")
    fields = {}
    for field in argv[2:]:
        name, separator, value = field.partition("=")
        if not separator or name in fields or name not in WIDGETS or (name not in ("cardStacks", "barWidth", *BAR_CHOICES) and value not in {"true", "false"}):
            raise ValueError("invalid widget request")
        if name == "barWidth" and not re.fullmatch(r"(?:[5-9][0-9]|100)", value):
            raise ValueError("invalid bar width request")
        fields[name] = int(value) if name == "barWidth" else parse_stacks(value) if name == "cardStacks" else value if name in BAR_CHOICES else value == "true"
        if not valid_widget(name, fields[name]):
            raise ValueError("invalid widget request")
    if not fields or not supported:
        raise ValueError("widget settings unavailable; restore shipped Settings.qml through Installer")
    if any(policy.get(name) is not None and fields[name] != policy[name] for name in fields):
        raise ValueError("Nix widget policy changed; reopen the manager")
    # Re-read under the existing defaults lock; preserve values owned by policy.
    theme.atomic_text(state / "widgets.json", json.dumps(saved | {
        name: fields[name] for name in fields if policy.get(name) is None
    }, sort_keys=True) + "\n", setting=True, signature=revision)
    print("Widget preferences saved; the shipped shell watches this file.")


# This bounded editor only accepts ordinary Super chords, never commands or Lua.
HOTKEYS = {"launcher": "SUPER+SPACE", "terminal": "SUPER+RETURN", "filemanager": "SUPER+E",
           "screenshot": "SUPER+PRINT", "lock": "SUPER+L"}
HOTKEY_MODS = {"SUPER": 64, "SHIFT": 1, "CTRL": 4, "ALT": 8}


def hotkey_chord(value):
    parts = value.upper().replace(" ", "").split("+")
    parts[-1] = {"ENTER": "RETURN"}.get(parts[-1], parts[-1])
    mods, key = parts[:-1], parts[-1]
    if (not mods or "SUPER" not in mods or len(set(mods)) != len(mods)
            or any(mod not in HOTKEY_MODS for mod in mods)
            or not re.fullmatch(r"[A-Z0-9]|RETURN|SPACE|PRINT|F[1-9]|F1[0-2]", key)):
        raise ValueError("Use Super, optional Shift/Ctrl/Alt, and A-Z, 0-9, Enter, Space, Print or F1-F12")
    return "+".join([mod for mod in HOTKEY_MODS if mod in mods] + [key])


def hotkey_values(raw):
    saved = {}
    for line in (raw.decode("utf-8").removesuffix("\n").split("\n") if raw else []):
        name, separator, chord = line.partition("=")
        if not separator or name not in HOTKEYS or name in saved or hotkey_chord(chord) != chord:
            raise ValueError("Invalid hotkey preferences")
        saved[name] = chord
    values = HOTKEYS | saved
    if len(set(values.values())) != len(values):
        raise ValueError("Hotkey conflicts with another managed action")
    return values


def hyprctl(*args):
    result = subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=10)
    if result.returncode:
        raise ValueError("Hyprland request failed: " + (result.stderr or result.stdout).strip())
    return result.stdout.strip()


def hotkey_bindings():
    bindings = json.loads(hyprctl("-j", "binds"))
    if not isinstance(bindings, list) or any(not isinstance(bind, dict) or any(
            type(bind.get(name, default)) is not type(default) for name, default in {
                "key": "", "description": "", "submap": "", "modmask": 0, "keycode": 0,
                "release": False, "mouse": False, "longPress": False, "repeat": False,
                "non_consuming": False, "catch_all": False,
            }.items()) for bind in bindings):
        raise ValueError("Invalid Hyprland bindings")
    return bindings


def hotkey_matches(bind, chord):
    parts = chord.split("+")
    return (bind.get("key", "").upper() == parts[-1]
            and bind.get("modmask") == sum(HOTKEY_MODS[mod] for mod in parts[:-1])
            and not bind.get("submap") and not bind.get("keycode")
            and not any(bind.get(flag) for flag in ("release", "mouse", "longPress", "repeat", "non_consuming", "catch_all")))


def hotkey_current(bindings):
    values = {}
    for name in HOTKEYS:
        matches = [bind for bind in bindings if bind.get("description") == "icewine:" + name]
        if len(matches) != 1:
            raise ValueError("Managed hotkeys unavailable in this session")
        bind = matches[0]
        chord = hotkey_chord("+".join([mod for mod, mask in HOTKEY_MODS.items() if bind.get("modmask", 0) & mask]
                                     + [bind.get("key", "")]))
        if not hotkey_matches(bind, chord):
            raise ValueError("Managed hotkey semantics changed; reopen after reload")
        values[name] = chord
    return values


def hotkey_managed(bindings, values):
    if hotkey_current(bindings) != values:
        raise ValueError("Managed hotkeys differ from this session; reload Hyprland and reopen")


def hotkey_conflict(bindings, name, chord):
    for bind in bindings:
        if bind.get("description") == "icewine:" + name:
            continue
        # Ponytail: binds JSON omits ignore_mods and keycode-to-keysym mapping.
        # Reserve noneditable symbols across modifiers/submaps; refuse opaque
        # keycode/catchall binds. Widen only when the compositor exposes overlap.
        managed = bind.get("description", "").removeprefix("icewine:") in HOTKEYS
        # The shipped exact-modifier session chord shares L with Lock.
        exact = managed or bind.get("description") == "icewine:session-end"
        if ((exact and hotkey_matches(bind, chord)) or (not exact and
                (bind.get("catch_all") or bind.get("keycode") or "code:" in bind.get("key", "").lower()
                 or bind.get("key", "").upper() == chord.split("+")[-1]))):
            raise ValueError("Hotkey conflicts with an existing binding")


def hotkeys(argv, state):
    path = state / "hotkeys"
    raw = path.read_bytes() if path.exists() else b""
    revision = hashlib.sha256(raw).hexdigest()
    values = hotkey_values(raw)
    readonly = theme.setting_readonly(path)
    if argv == ["hotkeys-state"]:
        live = False
        try:
            current = hotkey_current(hotkey_bindings())
            readonly = readonly or current != values
            values, live = current, True
        except (OSError, ValueError, subprocess.SubprocessError):
            readonly = True
        print("readonly=" + str(readonly).lower(), "live=" + str(live).lower(), "revision=" + revision,
              *[name + "=" + chord for name, chord in values.items()])
        return
    if len(argv) != 4 or argv[0] != "hotkeys-apply" or argv[2] not in HOTKEYS:
        raise ValueError("Invalid hotkey request")
    if readonly:
        raise ValueError("Hotkeys are Read Only")
    if argv[1] != revision:
        raise ValueError("Hotkeys changed; reopen before saving")
    name = argv[2]
    chord = HOTKEYS[name] if argv[3] == "default" else hotkey_chord(argv[3])
    selected = values | {name: chord}
    if len(set(selected.values())) != len(selected):
        raise ValueError("Hotkey conflicts with another managed action")
    bindings = hotkey_bindings()
    hotkey_managed(bindings, values)
    hotkey_conflict(bindings, name, chord)
    if hyprctl("configerrors"):
        raise ValueError("Resolve Hyprland configuration errors before editing")
    contents = "".join(name + "=" + chord + "\n" for name, chord in selected.items() if chord != HOTKEYS[name])
    theme.atomic_text(path, contents, setting=True, signature=revision)
    try:
        hyprctl("reload")
        if hyprctl("configerrors"):
            raise ValueError("Hyprland configuration reload failed")
        current = hotkey_bindings()
        hotkey_managed(current, selected)
        hotkey_conflict(current, name, chord)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        try:
            theme.atomic_text(path, raw, setting=True, signature=hashlib.sha256(contents.encode()).hexdigest())
            hyprctl("reload")
            hotkey_managed(hotkey_bindings(), values)
            if hyprctl("configerrors"):
                raise ValueError("Hyprland configuration errors remain")
        except (OSError, ValueError, subprocess.SubprocessError) as recovery:
            raise ValueError(f"Hotkey save failed; recovery needs attention: {recovery}") from error
        raise ValueError("Hotkey reload failed; previous bindings restored") from error
    print("Hotkey saved")


def run(argv, **kwargs):
    print("Running: " + " ".join(argv), flush=True)
    subprocess.run(argv, check=True, **kwargs)


def retire(config, data, state, feature):
    records = theme.default_records(state)
    for root_name, root in (("config", config), ("data", data), ("home", Path.home())):
        entry = records.get(root_name, {})
        if entry.get("root") != str(root):
            continue
        for name, signature in list(entry["files"].items()):
            if feature == "desktop":
                matches = root_name == "config" and name == "hypr/icewine"
            else:
                matches = theme.static_app(root_name, Path(name)) in APPS[feature]
            if not matches:
                continue
            path = root / name
            if theme.still_current(path, root, signature, signature[5:] if signature.startswith("link:") else None):
                path.unlink(missing_ok=True)
                del entry["files"][name]
    theme.atomic_text(state / "default-files.json", json.dumps(records, sort_keys=True) + "\n")


HANDHELD_RULES = Path("/etc/polkit-1/rules.d/90-icewine-handheld.rules")
HANDHELD_UNITS = ["icewine-controller-idle.service", "icewine-inputplumber-hyprland.service"]


def handheld_policy(state, enabled):
    record = state / "handheld-rules.sha256"
    if record.is_symlink():
        raise ValueError("refusing symlinked handheld ownership record")
    signature = theme.default_signature(HANDHELD_RULES)
    previous = record.read_text().strip() if record.exists() else None
    if enabled:
        if signature is not None and signature != previous:
            raise ValueError(f"preserved unrelated handheld policy: {HANDHELD_RULES}")
        source = Path(os.environ.get("ICEWINE_INPUTPLUMBER_ASSETS", "/usr/share/icewine/inputplumber")) / "polkit.rules.in"
        contents = source.read_text().replace("@user@", json.dumps(pwd.getpwuid(os.getuid()).pw_name))
        with tempfile.TemporaryDirectory(prefix="icewine-handheld-") as temporary:
            rules = Path(temporary) / "rules"
            rules.write_text(contents)
            run(["sudo", "install", "-Dm644", str(rules), str(HANDHELD_RULES)])
            theme.atomic_text(record, theme.default_signature(rules) + "\n")
    elif previous:
        if signature == previous and not HANDHELD_RULES.is_symlink():
            run(["sudo", "unlink", str(HANDHELD_RULES)])
        record.unlink()


def session_environment(selected):
    run(["systemctl", "--user", "set-environment", f"ICEWINE_STEAM_CLIENT={selected['steam']}",
         f"ICEWINE_STEAM_ENABLED={str(selected['steam'] != 'none').lower()}",
         f"ICEWINE_GAMESCOPE_ENABLED={str(selected['gamescope']).lower()}",
         f"ICEWINE_HANDHELD_ENABLED={str(selected['handheld']).lower()}"])


def apply(selected, overwrite, readonly, previous, config, data, state):
    if readonly and selected != previous:
        raise ValueError("utility selections are read-only (host policy or symlink)")
    if not readonly and platform.freedesktop_os_release().get("ID") not in {"arch", "cachyos"}:
        raise ValueError("host package/service changes are supported only on Arch/CachyOS")
    for name in ("applied.json", "default-files.json", "handheld-rules.sha256", *(() if readonly else ("manage.json",))):
        (theme.setting_target if name == "manage.json" else theme.writable)(state / name)
    # Read the previous explicit Apply on NixOS too: rebuilds never touch dotfiles.
    applied_path = state / "applied.json"
    if applied_path.is_symlink():
        raise ValueError("refusing symlinked applied-selection record")
    applied = validate(json.loads(applied_path.read_text()), saved=True) if applied_path.exists() else previous if (state / "manage.json").exists() else dict.fromkeys(FEATURES, False) | {"steam": "none", "screenshot": "none"}
    if not readonly and selected["login"]:
        raise ValueError("Login configuration belongs to the host; login styling is NixOS-only")
    if not readonly:
        packages = [package for feature in FEATURES if selected[feature] and feature not in {"steam", "screenshot"} for package in PACKAGES[feature]]
        if selected["steam"] == "native":
            packages.append("steam")
        if selected["steam"] == "flatpak":
            packages.append("flatpak")
        if selected["screenshot"] != "none":
            packages.append("hyprshot" if selected["screenshot"] == "simple" else "flameshot")
        local = []
        package_dir = os.environ.get("ICEWINE_PACKAGE_DIR")
        for package in ("icewine-session", "icewine-handheld", "icewine-keyboard", "icewine-controller-idle"):
            if package not in packages:
                continue
            archives = sorted(path for path in Path(package_dir).glob(package + "-[0-9]*.pkg.tar.*") if path.suffix != ".sig") if package_dir else []
            if len(archives) > 1:
                raise ValueError(f"expected one {package} archive in {package_dir}")
            if archives:
                # Prepared source takes precedence even at the same package version.
                local.append(str(archives[0].resolve()))
                packages.remove(package)
            elif subprocess.run(["pacman", "-Qq", package], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                packages.remove(package)
        if packages:
            run(["sudo", "pacman", "-S", "--needed", *packages])
        if local:
            run(["sudo", "pacman", "-U", *local])
        if selected["steam"] == "flatpak":
            run(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"])
            run(["flatpak", "install", "--user", "--noninteractive", "flathub", "com.valvesoftware.Steam"])
    shell_running = False
    changed = any(applied[name] != selected[name] for name in ("steam", "gamescope", "handheld")) or selected["handheld"] or (state / "handheld-rules.sha256").exists()
    try:
        if not readonly and changed:
            shell_running = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "icewine.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
            if shell_running:
                run(["systemctl", "--user", "stop", "icewine.service"])
            if applied["handheld"] or (state / "handheld-rules.sha256").exists():
                # Stop routing before removing its permission; ExecStopPost restores
                # controller defaults even after a failed oneshot start.
                run(["systemctl", "--user", "disable", "--now", *HANDHELD_UNITS])
            if applied["gamescope"] and changed and subprocess.run(["systemctl", "--user", "is-active", "--quiet", "icewine-steam-gamescope.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                run(["systemctl", "--user", "stop", "icewine-steam-gamescope.service"])
        if not readonly and (selected["handheld"] or applied["handheld"] or (state / "handheld-rules.sha256").exists()):
            handheld_policy(state, selected["handheld"])
        defaults = os.environ.get("ICEWINE_DEFAULT_FILES", "/usr/share/icewine/defaults")
        if not readonly and selected["handheld"]:
            defaults = os.environ.get("ICEWINE_HANDHELD_DEFAULT_FILES", "/usr/share/icewine/defaults-handheld")
        if not (Path(defaults) / "config").is_dir() or not (Path(defaults) / "data").is_dir():
            raise ValueError(f"Icewine default files are unavailable: {defaults}")
        assets = Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine/theme"))
        themes = theme.installed(assets)
        theme_id, _ = theme.effective(state, themes)
        files = theme.render_theme(assets, themes[theme_id], theme.transparency_level(state))
        if theme.render_readonly(config):
            print("read-only symlink: preserved generated theme configuration", file=sys.stderr)
        else:
            theme.publish(config, files)
        for feature in FEATURES:
            if applied[feature] and not selected[feature]:
                retire(config, data, state, feature)
        for app in ("quickshell", "wallpapers"):
            theme.install_defaults(defaults, config, data, state, overwrite, app)
        # Ponytail: GTK-only Apply is deferred until independently used; then honour its existing gate without changing Arch coupling.
        for feature in FEATURES:
            if not selected[feature]:
                continue
            for app in APPS[feature]:
                theme.install_defaults(defaults, config, data, state, overwrite, app)
                if app in theme.APPS and theme.APPS[app]:
                    theme.install_links(config, state, overwrite, app)
        if selected["filemanager"] and not readonly:
            if any(theme.symlinked(config / name) for name in ("mimeapps.list", "mimeapps.list.new")):
                print(f"read-only symlink: preserved {config / 'mimeapps.list'}", file=sys.stderr)
            else:
                # Set the generic XDG file, independent of the onboarding desktop.
                run(["xdg-mime", "default", "icewine-yazi.desktop", "inode/directory"],
                    env=dict(os.environ, XDG_CURRENT_DESKTOP="X-Generic", DE="generic", XDG_UTILS_INSTALL_MODE="user"))
        if selected["desktop"] and os.environ.get("ICEWINE_GTK_ENABLE", "true") != "false":
            theme.install_gtk_theme(config, theme_id)
        if not readonly and changed:
            session_environment(selected)
            run(["systemctl", "--user", "daemon-reload"])
            if selected["handheld"]:
                run(["sudo", "systemctl", "start", "inputplumber.service"])
                run(["systemctl", "--user", "enable", *HANDHELD_UNITS])
                if shell_running:
                    run(["systemctl", "--user", "start", *reversed(HANDHELD_UNITS)])
            if shell_running:
                run(["systemctl", "--user", "start", "icewine.service"])
    except Exception:
        if not readonly and changed:
            # Leave the shell stopped and routes restored on a failed transition.
            # A retained ownership record makes a later Apply retry teardown.
            if shell_running:
                try:
                    run(["systemctl", "--user", "stop", "icewine.service"])
                except subprocess.CalledProcessError as error:
                    print(f"Failed to stop Icewine shell: {error}", file=sys.stderr)
            if selected["handheld"] or applied["handheld"] or (state / "handheld-rules.sha256").exists():
                try:
                    run(["systemctl", "--user", "disable", "--now", *HANDHELD_UNITS])
                    handheld_policy(state, False)
                except (subprocess.CalledProcessError, OSError, ValueError) as error:
                    print(f"Failed Handheld teardown; retry Apply: {error}", file=sys.stderr)
            try:
                session_environment(applied | {"handheld": False})
            except subprocess.CalledProcessError as error:
                print(f"Failed to restore session flags: {error}", file=sys.stderr)
        raise
    theme.atomic_text(applied_path, json.dumps(selected, sort_keys=True) + "\n")
    if not readonly:
        theme.atomic_text(state / "manage.json", json.dumps(selected, sort_keys=True) + "\n", setting=True)
    print("Applied Icewine selections. Reopen with icewine; existing dotfiles are preserved by default.")
    if selected["desktop"]:
        print("Keep your fallback desktop. Next login: Hyprland (UWSM) on NixOS; Icewine on Arch/CachyOS, or icewine-session from a logged-in TTY.")
        print("Session diagnosis: journalctl --user -u icewine.service -b")
    if not readonly:
        print("Experimental Arch/CachyOS: installed-session and device qualification remain pending.")


def main(argv):
    config, data = theme.xdg("XDG_CONFIG_HOME", ".config"), theme.xdg("XDG_DATA_HOME", ".local/share")
    state = theme.xdg("XDG_STATE_HOME", ".local/state") / "icewine"
    if argv == ["hotkeys-state"]:
        hotkeys(argv, state)
        return
    if argv == ["widget-icons"]:
        try:
            result = subprocess.run(["qs", "ipc", "call", "topbar", "icons"], capture_output=True, text=True, timeout=2)
            if result.returncode == 0:
                # Only transport printable single glyphs for known modules.
                fields = dict(field.split("=", 1) for field in result.stdout.split())
                if set(fields) == set(CARD_MODULES) and all(len(value) == 1 and value.isprintable() for value in fields.values()):
                    print(result.stdout.strip())
                    return
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
        assets = Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine/theme"))
        themes = theme.installed(assets)
        theme_id, _ = theme.effective(state, themes)
        glyph = json.loads(theme.render_theme(assets, themes[theme_id])["palette.json"])["osGlyph"]
        print(" ".join(f"{name}={icon}" for name, icon in zip(CARD_MODULES,
            (glyph, "󰀻", "󰕰", "", "", "", "󰅌", "󰯡", "󰒍", "󰣀", "󰂜", "󰐥", "󰓅"))))
        return
    if len(argv) == 2 and argv[0] == "theme-preview":
        assets = Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine/theme"))
        themes = theme.installed(assets)
        if argv[1] not in themes:
            raise ValueError("theme is not installed")
        palette = json.loads(theme.render_theme(assets, themes[argv[1]], theme.transparency_level(state))["palette.json"])
        print(" ".join(f"{name}={palette[name]}" for name in ("primary", "foreground", "background", "muted", "secondary", "tertiary")))
        return
    if argv in (["screenshot"], ["screenshot", "screen"]):
        _, selected = selections(state)
        mode = selected["screenshot"]
        if mode == "none":
            raise ValueError("Screenshot is disabled in Utilities")
        command = (["hyprshot", "-m", "output" if len(argv) == 2 else "region"] if mode == "simple"
                   else ["flameshot", "screen", "--edit"] if len(argv) == 2 else ["flameshot", "gui"])
        run(command)
        return
    if argv == ["appearance-state"]:
        themes = theme.installed(Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine")))
        if theme.DEFAULT not in themes:
            raise ValueError("Tokyo Night assets are missing")
        selected, policy = theme.effective(state, themes)
        render = theme.render_readonly(config)
        wallpaper_data = Path(os.environ.get("ICEWINE_WALLPAPER_DATA_HOME") or data)
        fields = {
            "themes": ",".join(sorted(themes)), "selected": selected,
            "policy": str(policy).lower(), "level": theme.transparency_level(state),
            "desktopLayout": theme.layout_default(state),
        }
        fields.update({name: str(bool(link)).lower() for name, link in {
            "theme": theme.setting_readonly(state / "theme") or render,
            "transparency": theme.setting_readonly(state / "transparency") or render,
            "wallpaper": theme.setting_readonly(wallpaper_data / "icewine/wallpapers/selection.img"),
            "monitors": theme.setting_readonly(config / "hypr/hyprland.lua") or theme.setting_readonly(config / "hypr/hyprmon.lua"),
            "layout": theme.setting_readonly(state / "layout"),
        }.items()})
        print(" ".join(f"{name}={value}" for name, value in fields.items()))
        return
    if argv == ["widgets-state"]:
        widgets(argv, config, state)
        return
    hotkey_request = bool(argv) and argv[0] == "hotkeys-apply"
    widget_request = bool(argv) and argv[0] == "widgets-apply"
    readonly, previous = selections(state) if not (widget_request or hotkey_request) else (False, {})
    if argv == ["state"]:
        print(" ".join(f"{name}={str(bit).lower()}" for name, bit in {"readonly": readonly, **previous}.items()))
        return
    if not (widget_request or hotkey_request) and (not argv or argv[0] != "apply"):
        raise ValueError("invalid manager request")
    if not (widget_request or hotkey_request):
        fields = {}
        for field in argv[1:]:
            name, separator, value = field.partition("=")
            if not separator or name in fields or value not in ({"none", "native", "flatpak"} if name == "steam" else {"none", "simple", "advanced"} if name == "screenshot" else {"true", "false"}):
                raise ValueError("invalid manager request")
            fields[name] = value if name in {"steam", "screenshot"} else value == "true"
        if "overwrite" not in fields:
            raise ValueError("missing overwrite choice")
        overwrite = fields.pop("overwrite")
        selected = validate(fields)
    if os.getuid() == 0:
        raise ValueError("run icewine as your desktop user")
    lock_path = (state.resolve() if widget_request or hotkey_request else state) / "defaults.lock"
    theme.writable(lock_path)
    state.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "r+") as lock:
        # Ponytail: one lock serialises explicit Apply; split by root if contention matters.
        fcntl.flock(lock, fcntl.LOCK_EX)
        if hotkey_request:
            hotkeys(argv, state)
            return
        if widget_request:
            widgets(argv, config, state)
            return
        readonly, previous = selections(state)
        apply(selected, overwrite, readonly, previous, config, data, state)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"Icewine Apply failed: {error}", file=sys.stderr)
        if sys.argv[1:2] == ["apply"]:
            print("Earlier packages/files may have changed; no complete rollback occurred. Resolve the error, then reopen icewine and retry Apply with overwrite off. Keep the local split-package directory available.", file=sys.stderr)
        sys.exit(1)
