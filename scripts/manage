#!/usr/bin/env python3
"""Backend for explicit manager Apply; deployment shares the theme helpers."""
import fcntl
import hashlib
import importlib.machinery
import json
import os
from pathlib import Path
import platform
import pwd
import re
import shutil
import subprocess
import sys
import tempfile
import types

# Installed beside theme on Arch; Nix wrappers provide the source path.
theme = types.ModuleType("icewine_theme")
theme.__file__ = os.environ.get("ICEWINE_THEME_SCRIPT", str(Path(__file__).with_name("theme")))
importlib.machinery.SourceFileLoader(theme.__name__, theme.__file__).exec_module(theme)
FEATURES = ("desktop", "terminal", "filemanager", "steam", "gamescope", "handheld", "login", "shellExtras", "texteditor", "screenshot", "media")
APPS = {
    "desktop": ("hypr", "uwsm", "gtk", "user-dirs", "applications"),
    "terminal": ("kitty",), "filemanager": ("yazi",),
    "steam": (), "gamescope": ("gamescope",), "handheld": (), "login": (),
    "shellExtras": ("starship", "fastfetch", "btop"), "texteditor": (), "screenshot": (), "media": (),
}
PACKAGES = {
    "desktop": ("icewine-session",), "terminal": ("kitty",),
    "filemanager": ("yazi", "xdg-terminal-exec", "ffmpegthumbnailer", "7zip", "gvfs", "udisks2"),
    "steam": (), "gamescope": ("gamescope",), "handheld": ("icewine-handheld", "icewine-controller-idle", "inputplumber"),
    "login": (), "shellExtras": ("starship", "fastfetch"), "texteditor": ("neovim", "git", "gcc", "make", "ripgrep", "fd", "unzip"), "screenshot": (), "media": ("imv",),
}


def validate(value, *, saved=False):
    original = value
    legacy = {"desktop", "terminal", "filemanager", "gaming", "flatpak", "login", "shellExtras"}
    if saved and isinstance(value, dict) and set(value) in (legacy, legacy | {"texteditor"}) and all(type(bit) is bool for bit in value.values()):
        value = {name: value[name] for name in legacy - {"gaming", "flatpak"}} | {
            "steam": ("flatpak" if value["flatpak"] else "native") if value["gaming"] else "none",
            "gamescope": value["gaming"], "handheld": False,
        }
    previous = set(FEATURES) - {"texteditor", "screenshot", "media"}
    if saved and isinstance(value, dict) and set(value) == previous:
        value = value | {"texteditor": original.get("texteditor", False),
                         "screenshot": value["desktop"]}
    if saved and isinstance(value, dict) and value.get("screenshot") in ("none", "simple", "advanced"):
        value = value | {"screenshot": value["screenshot"] != "none"}
    if saved and isinstance(value, dict) and set(value) == set(FEATURES) - {"media"}:
        value = value | {"media": False}
    if (not isinstance(value, dict) or set(value) != set(FEATURES)
            or value["steam"] not in ("none", "native", "flatpak")
            or any(type(bit) is not bool for name, bit in value.items() if name != "steam")):
        raise ValueError("invalid manager selections")
    if value["steam"] == "none" and (value["gamescope"] or value["handheld"]):
        raise ValueError("Gamescope and Handheld require Steam")
    if value["handheld"] and not (value["desktop"] and value["steam"] == "native" and value["gamescope"]):
        raise ValueError("Handheld requires desktop, native Steam and Gamescope")
    return value


def selections(state):
    declared = os.environ.get("ICEWINE_MANAGE_SELECTIONS")
    if declared is not None:
        return True, validate(json.loads(declared))
    if platform.freedesktop_os_release().get("ID") not in {"arch", "cachyos"}:
        raise ValueError("Icewine manager supports Arch/CachyOS or the NixOS module")
    path = state / "manage.json"
    saved = validate(json.loads(path.read_text()), saved=True) if path.exists() else dict.fromkeys(FEATURES, True) | {"steam": "flatpak", "handheld": False, "login": False}
    return theme.setting_readonly(path), saved | {"login": False}


WIDGETS = ("notificationToasts", "windowSwitcher", "cardStacks", "barBehaviour", "barLocation", "barStyle", "barWidth", "oskAccess")
BAR_CHOICES = {"barBehaviour": ("keyboard", "keyboard-mouse", "toggle", "always"),
               "barLocation": ("above", "top", "bottom"), "barStyle": ("anchored", "floating"),
               "oskAccess": ("none", "launcher", "topbar")}


def valid_widget(name, value):
    if name == "barWidth":
        return type(value) is int and 50 <= value <= 100
    if name == "cardStacks":
        return True  # Validated separately below, with the existing policy diagnostic.
    return value in BAR_CHOICES[name] if name in BAR_CHOICES else type(value) is bool


def widget_default(name):
    if name == "barWidth":
        return 80
    return BAR_CHOICES[name][0] if name in BAR_CHOICES else CARD_DEFAULTS if name == "cardStacks" else True
CARD_MODULES = ("launcher", "background", "layout", "media", "audio", "bluetooth",
                "clipboard", "network", "tailscale", "ssh", "notifications", "battery", "performance")
CARD_DEFAULTS = [{"id": names[0], "modules": list(names)} for names in (
    ("launcher", "background", "layout"), ("media",), ("audio", "bluetooth"),
    ("network", "tailscale", "ssh"), ("notifications", "clipboard"), ("battery", "performance"))]


def validate_stacks(stacks):
    if not isinstance(stacks, list):
        raise ValueError("invalid card stacks")
    ids, members = set(), set()
    for stack in stacks:
        if (not isinstance(stack, dict) or set(stack) != {"id", "modules"}
                or not isinstance(stack["id"], str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", stack["id"])
                or stack["id"] in ids or not isinstance(stack["modules"], list) or not stack["modules"]):
            raise ValueError("invalid card stack")
        ids.add(stack["id"])
        for name in stack["modules"]:
            if name not in CARD_MODULES or name in members:
                raise ValueError("invalid card module")
            members.add(name)
    return stacks


def stack_text(stacks):
    # IDs cannot contain these delimiters; keep the existing whitespace protocol.
    return ";".join(stack["id"] + "/" + ",".join(stack["modules"]) for stack in stacks)


def parse_stacks(text):
    stacks = []
    for entry in text.split(";") if text else []:
        name, separator, members = entry.partition("/")
        if not separator:
            raise ValueError("invalid card stack request")
        stacks.append({"id": name, "modules": members.split(",")})
    return validate_stacks(stacks)


def widget_state(config, state):
    policy = json.loads(os.environ.get("ICEWINE_WIDGET_POLICY", "{}"))
    if (not isinstance(policy, dict) or set(policy) - set(WIDGETS)
            or any(value is not None and not valid_widget(name, value) for name, value in policy.items())):
        raise ValueError("invalid widget policy; Widgets are read-only")
    if policy.get("cardStacks") is not None:
        try:
            validate_stacks(policy["cardStacks"])
        except ValueError as error:
            raise ValueError("invalid cardStacks policy; Widgets are read-only") from error
    path = state / "widgets.json"
    contents = path.read_bytes() if path.exists() else None
    saved = json.loads(contents) if contents is not None else {}
    revision = hashlib.sha256(contents or b"").hexdigest()
    if (not isinstance(saved, dict) or set(saved) - set(WIDGETS)
            or any(not valid_widget(name, value) for name, value in saved.items())):
        raise ValueError("invalid widget selections; repair widgets.json before saving")
    if "cardStacks" in saved:
        validate_stacks(saved["cardStacks"])
    settings = config / "quickshell/config/Settings.qml"
    # Custom settings remain editable; do not promise delivery through an
    # unknown implementation. Restore shipped settings to enable these controls.
    shipped = Path(os.environ.get("ICEWINE_WIDGET_SETTINGS",
        "/usr/share/icewine/defaults/config/quickshell/config/Settings.qml"))
    entries = os.environ.get("ICEWINE_WIDGET_SHELLS",
        "/usr/share/icewine/defaults/config/quickshell/shell.qml:"
        "/usr/share/icewine/defaults-handheld/config/quickshell/shell.qml").split(os.pathsep)
    entry = config / "quickshell/shell.qml"
    supported = (settings.is_file() and shipped.is_file() and settings.read_bytes() == shipped.read_bytes()
                 and entry.is_file() and any(Path(path).is_file() and entry.read_bytes() == Path(path).read_bytes()
                                            for path in entries))
    return saved, policy, supported, revision


def widgets(argv, config, state):
    saved, policy, supported, revision = widget_state(config, state)
    readonly = theme.setting_readonly(state / "widgets.json")
    if argv == ["widgets-state"]:
        print("supported=" + str(supported).lower(), "revision=" + revision, *[
            f"{name}={stack_text(value) if name == 'cardStacks' else str(value).lower()}:{'policy' if policy.get(name) is not None else 'readonly' if readonly else 'user'}"
            for name in WIDGETS
            for value in [policy[name] if policy.get(name) is not None else saved.get(name, widget_default(name))]])
        return
    theme.setting_target(state / "widgets.json")
    if len(argv) < 3 or argv[1] != "revision=" + revision:
        raise ValueError("Widget preferences changed; reopen the manager before saving")
    fields = {}
    for field in argv[2:]:
        name, separator, value = field.partition("=")
        if not separator or name in fields or name not in WIDGETS or (name not in ("cardStacks", "barWidth", *BAR_CHOICES) and value not in {"true", "false"}):
            raise ValueError("invalid widget request")
        if name == "barWidth" and not re.fullmatch(r"(?:[5-9][0-9]|100)", value):
            raise ValueError("invalid bar width request")
        fields[name] = int(value) if name == "barWidth" else parse_stacks(value) if name == "cardStacks" else value if name in BAR_CHOICES else value == "true"
        if not valid_widget(name, fields[name]):
            raise ValueError("invalid widget request")
    if not fields or not supported:
        raise ValueError("widget settings unavailable; restore shipped Settings.qml through Installer")
    if any(policy.get(name) is not None and fields[name] != policy[name] for name in fields):
        raise ValueError("Nix widget policy changed; reopen the manager")
    # Re-read under the existing defaults lock; preserve values owned by policy.
    theme.atomic_text(state / "widgets.json", json.dumps(saved | {
        name: fields[name] for name in fields if policy.get(name) is None
    }, sort_keys=True) + "\n", setting=True, signature=revision)
    print("Widget preferences saved; the shipped shell watches this file.")


# The same shipped data drives Lua registration and the terminal editor.
BINDINGS_FILE = Path(os.environ.get("ICEWINE_BINDINGS_FILE", str(Path(__file__).resolve().parents[1] / "hyprland/modules/Bindings.tsv")))
HOTKEY_ROWS = [line.split("\t") for line in BINDINGS_FILE.read_text().splitlines()]
HOTKEYS = {row[0]: row[3] for row in HOTKEY_ROWS}
HOTKEY_DEFINITIONS = {row[0]: row for row in HOTKEY_ROWS}
HOTKEY_MODS = {"SUPER": 64, "SHIFT": 1, "CTRL": 4, "ALT": 8}
HOTKEY_KEYS = {chord.split("+")[-1] for chord in HOTKEYS.values()}
HOTKEY_MODIFIER_KEYS = {"SUPER": ("SUPER_L", "SUPER_R"), "SHIFT": ("SHIFT_L", "SHIFT_R"),
                        "CTRL": ("CONTROL_L", "CONTROL_R"), "ALT": ("ALT_L", "ALT_R")}


def hotkey_chord(value, name=None):
    parts = value.upper().replace(" ", "").split("+")
    parts[-1] = {"ENTER": "RETURN", "PAGEUP": "PRIOR", "PAGEDOWN": "NEXT", "`": "GRAVE"}.get(parts[-1], parts[-1])
    mods, key = parts[:-1], parts[-1]
    if (len(set(mods)) != len(mods) or any(mod not in HOTKEY_MODS for mod in mods)
            or not (key in HOTKEY_KEYS or re.fullmatch(r"[A-Z0-9]|RETURN|SPACE|PRINT|F[1-9]|F1[0-2]|MOUSE:27[2-9]", key))):
        raise ValueError("Use Shift/Ctrl/Alt/Super and a key, media key, wheel or mouse:272-279")
    kind = HOTKEY_DEFINITIONS[name][4] if name else None
    button = key.startswith("MOUSE:")
    if kind == "mouse" and not button:
        raise ValueError("Mouse drag needs a mouse:272-279 button")
    if kind and kind != "mouse" and button:
        raise ValueError("Use a key or wheel for this action")
    if kind in ("hold", "switcher") and (not mods or key.startswith("MOUSE_")):
        raise ValueError("Hold/release actions need a modifier and a keyboard key")
    return "+".join([mod for mod in HOTKEY_MODS if mod in mods] + [key])


def hotkey_values(raw):
    saved = {}
    for line in (raw.decode("utf-8").removesuffix("\n").split("\n") if raw else []):
        name, separator, chord = line.partition("=")
        if not separator or name not in HOTKEYS or name in saved or hotkey_chord(chord, name) != chord:
            raise ValueError("Invalid hotkey preferences")
        saved[name] = chord
    values = HOTKEYS | saved
    if len(set(values.values())) != len(values):
        raise ValueError("Hotkey conflicts with another managed action")
    return values


def hyprctl(*args):
    result = subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=10)
    if result.returncode:
        raise ValueError("Hyprland request failed: " + (result.stderr or result.stdout).strip())
    return result.stdout.strip()


def hotkey_bindings():
    bindings = json.loads(hyprctl("-j", "binds"))
    if not isinstance(bindings, list) or any(not isinstance(bind, dict) or any(
            type(bind.get(name, default)) is not type(default) for name, default in {
                "key": "", "description": "", "submap": "", "modmask": 0, "keycode": 0,
                "release": False, "mouse": False, "longPress": False, "repeat": False, "locked": False,
                "non_consuming": False, "catch_all": False,
            }.items()) for bind in bindings):
        raise ValueError("Invalid Hyprland bindings")
    return bindings


def hotkey_same_chord(bind, chord):
    parts = chord.split("+")
    return (bind.get("key", "").upper() == parts[-1]
            and bind.get("modmask") == sum(HOTKEY_MODS[mod] for mod in parts[:-1])
            and not bind.get("submap") and not bind.get("keycode"))


def hotkey_matches(bind, chord, name):
    flags = HOTKEY_DEFINITIONS[name][5].split(",")
    # Lua hl.bind leaves kb.mouse false; drag/resize dispatchers own releasePending.
    return hotkey_same_chord(bind, chord) and not bind.get("mouse") and all(bool(bind.get(flag)) == (expected in flags) for flag, expected in (
        ("release", "release"), ("longPress", "long_press"), ("repeat", "repeating"),
        ("locked", "locked"), ("non_consuming", "non_consuming"), ("catch_all", "catch_all")))


def hotkey_current(bindings, saved):
    values, available = {}, {}
    for name in HOTKEYS:
        matches = [bind for bind in bindings if bind.get("description") == "icewine:" + name]
        # Browser is intentionally omitted when DefaultApps.browser is empty.
        if not matches and name == "browser":
            values[name], available[name] = saved[name], False
            continue
        if len(matches) != 1:
            raise ValueError("Managed hotkeys unavailable in this session")
        bind = matches[0]
        chord = hotkey_chord("+".join([mod for mod, mask in HOTKEY_MODS.items() if bind.get("modmask", 0) & mask]
                                     + [bind.get("key", "")]), name)
        if not hotkey_matches(bind, chord, name):
            raise ValueError("Managed hotkey semantics changed; reopen after reload")
        values[name], available[name] = chord, True
    expected = {key for chord in values.values() for mod in chord.split("+")[:-1] for key in HOTKEY_MODIFIER_KEYS[mod]}
    helpers = [bind for bind in bindings if bind.get("description", "").startswith("icewine:taskbar-modifier-")]
    if len(helpers) != len(expected) or {bind.get("key", "").upper() for bind in helpers} != expected or any(
            bind.get("description") != "icewine:taskbar-modifier-" + bind.get("key", "").upper()
            or bind.get("modmask") != 0 or bind.get("submap") or bind.get("keycode")
            or not bind.get("non_consuming") or any(bind.get(flag) for flag in ("release", "repeat", "mouse", "catch_all", "longPress"))
            for bind in helpers):
        raise ValueError("Taskbar release bindings changed; reload Hyprland and reopen")
    return values, available


def hotkey_managed(bindings, values):
    current, available = hotkey_current(bindings, values)
    if any(current[name] != chord for name, chord in values.items() if available[name]):
        raise ValueError("Managed hotkeys differ from this session; reload Hyprland and reopen")
    return available


def hotkey_conflict(bindings, name, chord):
    for bind in bindings:
        if bind.get("description") == "icewine:" + name:
            continue
        # Ponytail: binds JSON omits ignore_mods and keycode-to-keysym mapping.
        # Reserve custom symbols across modifiers/submaps; refuse opaque
        # keycode/catchall binds until the compositor exposes their overlap.
        managed = (bind.get("description", "").removeprefix("icewine:") in HOTKEYS
                   or bind.get("description") in ("icewine:preview-tab", "icewine:preview-backtab"))
        if ((managed and hotkey_same_chord(bind, chord)) or (not managed and
                (bind.get("catch_all") or bind.get("keycode") or "code:" in bind.get("key", "").lower()
                 or bind.get("key", "").upper() == chord.split("+")[-1]))):
            raise ValueError("Hotkey conflicts with an existing binding")


def hotkeys(argv, state):
    path = state / "hotkeys"
    raw = path.read_bytes() if path.exists() else b""
    revision = hashlib.sha256(raw).hexdigest()
    values = hotkey_values(raw)
    readonly = theme.setting_readonly(path)
    if argv == ["hotkeys-state"]:
        live = False
        available = {name: False for name in HOTKEYS}
        try:
            current, available = hotkey_current(hotkey_bindings(), values)
            readonly = readonly or any(current[name] != chord for name, chord in values.items() if available[name])
            values = {name: current[name] if available[name] else chord for name, chord in values.items()}
            live = True
        except (OSError, ValueError, subprocess.SubprocessError):
            readonly = True
        print("readonly=" + str(readonly).lower(), "live=" + str(live).lower(), "revision=" + revision,
              *[name + "=" + chord for name, chord in values.items()])
        for name, categories, label, default, kind, _ in HOTKEY_ROWS:
            print("\t".join((name, categories, label, default, kind, str(available[name]).lower())))
        return
    if len(argv) != 4 or argv[0] != "hotkeys-apply" or argv[2] not in HOTKEYS:
        raise ValueError("Invalid hotkey request")
    if readonly:
        raise ValueError("Hotkeys are Read Only")
    if argv[1] != revision:
        raise ValueError("Hotkeys changed; reopen before saving")
    name = argv[2]
    chord = HOTKEYS[name] if argv[3] == "default" else hotkey_chord(argv[3], name)
    selected = values | {name: chord}
    if len(set(selected.values())) != len(selected):
        raise ValueError("Hotkey conflicts with another managed action")
    bindings = hotkey_bindings()
    hotkey_managed(bindings, values)
    hotkey_conflict(bindings, name, chord)
    if hyprctl("configerrors"):
        raise ValueError("Resolve Hyprland configuration errors before editing")
    contents = "".join(name + "=" + chord + "\n" for name, chord in selected.items() if chord != HOTKEYS[name])
    theme.atomic_text(path, contents, setting=True, signature=revision)
    try:
        hyprctl("reload")
        if hyprctl("configerrors"):
            raise ValueError("Hyprland configuration reload failed")
        current = hotkey_bindings()
        hotkey_managed(current, selected)
        hotkey_conflict(current, name, chord)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        try:
            theme.atomic_text(path, raw, setting=True, signature=hashlib.sha256(contents.encode()).hexdigest())
            hyprctl("reload")
            hotkey_managed(hotkey_bindings(), values)
            if hyprctl("configerrors"):
                raise ValueError("Hyprland configuration errors remain")
        except (OSError, ValueError, subprocess.SubprocessError) as recovery:
            raise ValueError(f"Hotkey save failed; recovery needs attention: {recovery}") from error
        raise ValueError("Hotkey reload failed; previous bindings restored") from error
    print("Hotkey saved")


def run(argv, **kwargs):
    print("Running: " + " ".join(argv), flush=True)
    subprocess.run(argv, check=True, **kwargs)


def retire(config, data, state, feature):
    records = theme.default_records(state)
    for root_name, root in (("config", config), ("data", data), ("home", Path.home())):
        entry = records.get(root_name, {})
        if entry.get("root") != str(root):
            continue
        for name, signature in list(entry["files"].items()):
            if feature == "desktop":
                matches = root_name == "config" and name == "hypr/icewine"
            else:
                matches = theme.static_app(root_name, Path(name)) in APPS[feature]
            if not matches:
                continue
            path = root / name
            if theme.still_current(path, root, signature, signature[5:] if signature.startswith("link:") else None):
                path.unlink(missing_ok=True)
                del entry["files"][name]
    theme.atomic_text(state / "default-files.json", json.dumps(records, sort_keys=True) + "\n")


HANDHELD_RULES = Path("/etc/polkit-1/rules.d/90-icewine-handheld.rules")
HANDHELD_UNITS = ["icewine-controller-idle.service", "icewine-inputplumber-hyprland.service"]


def handheld_policy(state, enabled):
    record = state / "handheld-rules.sha256"
    if record.is_symlink():
        raise ValueError("refusing symlinked handheld ownership record")
    signature = theme.default_signature(HANDHELD_RULES)
    previous = record.read_text().strip() if record.exists() else None
    if enabled:
        if signature is not None and signature != previous:
            raise ValueError(f"preserved unrelated handheld policy: {HANDHELD_RULES}")
        source = Path(os.environ.get("ICEWINE_INPUTPLUMBER_ASSETS", "/usr/share/icewine/inputplumber")) / "polkit.rules.in"
        contents = source.read_text().replace("@user@", json.dumps(pwd.getpwuid(os.getuid()).pw_name))
        with tempfile.TemporaryDirectory(prefix="icewine-handheld-") as temporary:
            rules = Path(temporary) / "rules"
            rules.write_text(contents)
            run(["sudo", "install", "-Dm644", str(rules), str(HANDHELD_RULES)])
            theme.atomic_text(record, theme.default_signature(rules) + "\n")
    elif previous:
        if signature == previous and not HANDHELD_RULES.is_symlink():
            run(["sudo", "unlink", str(HANDHELD_RULES)])
        record.unlink()


def session_environment(selected):
    run(["systemctl", "--user", "set-environment", f"ICEWINE_STEAM_CLIENT={selected['steam']}",
         f"ICEWINE_STEAM_ENABLED={str(selected['steam'] != 'none').lower()}",
         f"ICEWINE_GAMESCOPE_ENABLED={str(selected['gamescope']).lower()}",
         f"ICEWINE_HANDHELD_ENABLED={str(selected['handheld']).lower()}"])


def onboarding_login():
    """Only the fresh headless path may take ownership of the login service."""
    managed = subprocess.run(["pacman", "-Qq", "icewine-login"], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL).returncode == 0
    display = Path("/etc/systemd/system/display-manager.service")
    if display.exists() or display.is_symlink():
        if not managed or display.resolve() != Path("/usr/lib/systemd/system/greetd.service"):
            raise ValueError("Existing display manager: keep host login; headless onboarding cannot replace it")
    for root in (Path("/etc/systemd/system"), Path("/run/systemd/system")):
        if any((root / name).exists() or (root / name).is_symlink()
               for name in ("greetd.service", "greetd.service.d")):
            raise ValueError("Existing greetd service override: preserve it; use host-owned login")
    if not managed and subprocess.run(["pacman", "-Qq", "greetd"], stdout=subprocess.DEVNULL,
                                      stderr=subprocess.DEVNULL).returncode == 0:
        raise ValueError("Existing greetd installation: preserve host login configuration")
    for unit in ("display-manager.service", "greetd.service"):
        if subprocess.run(["systemctl", "is-active", "--quiet", unit], stdout=subprocess.DEVNULL,
                          stderr=subprocess.DEVNULL).returncode == 0:
            raise ValueError("A login service is running; headless onboarding requires a TTY-only host")


def prepare_onboarding(config, data, state):
    if platform.freedesktop_os_release().get("ID") not in {"arch", "cachyos"}:
        raise ValueError("session onboarding supports only Arch/CachyOS")
    onboarding_login()  # Read-only ownership preflight; service changes stay at Apply.
    defaults = os.environ.get("ICEWINE_DEFAULT_FILES", "/usr/share/icewine/defaults")
    assets = Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine/theme"))
    themes = theme.installed(assets)
    theme_id, _ = theme.effective(state, themes)
    if not theme.render_readonly(config):
        theme.publish(config, theme.render_theme(assets, themes[theme_id], theme.transparency_level(state)))
    for app in ("hypr", "quickshell", "wallpapers"):
        theme.install_defaults(defaults, config, data, state, False, app)
    if not (config / "icewine/current/Theme.lua").is_file():
        raise ValueError("Core theme is unavailable; preserve personal files and inspect the retained preparation")
    if not widget_state(config, state)[2]:
        raise ValueError("Custom Quickshell files preserved; full onboarding requires the shipped core Settings.qml and shell.qml")
    print("Prepared missing core defaults; existing personal files and utility selections are preserved.")


def apply(selected, overwrite, readonly, previous, config, data, state):
    if readonly and selected != previous:
        raise ValueError("utility selections are read-only (host policy or symlink)")
    if not readonly and platform.freedesktop_os_release().get("ID") not in {"arch", "cachyos"}:
        raise ValueError("host package/service changes are supported only on Arch/CachyOS")
    for name in ("applied.json", "default-files.json", "handheld-rules.sha256", *(() if readonly else ("manage.json",))):
        (theme.setting_target if name == "manage.json" else theme.writable)(state / name)
    # Read the previous explicit Apply on NixOS too: rebuilds never touch dotfiles.
    applied_path = state / "applied.json"
    if applied_path.is_symlink():
        raise ValueError("refusing symlinked applied-selection record")
    applied = validate(json.loads(applied_path.read_text()), saved=True) if applied_path.exists() else previous if (state / "manage.json").exists() else dict.fromkeys(FEATURES, False) | {"steam": "none"}
    if not readonly and selected["login"]:
        raise ValueError("Login configuration belongs to the host; login styling is NixOS-only")
    onboarding = os.environ.get("ICEWINE_ONBOARDING") == "1"
    if onboarding:
        if readonly or not selected["desktop"] or selected["handheld"]:
            raise ValueError("Headless onboarding requires Desktop and supports desktop/laptop only; leave Handheld off")
        onboarding_login()
    if not readonly:
        packages = [package for feature in FEATURES if selected[feature] and feature != "steam" for package in PACKAGES[feature]]
        if selected["steam"] == "native":
            packages.append("steam")
        if selected["steam"] == "flatpak" or selected["screenshot"] or selected["media"]:
            packages.append("flatpak")
        if onboarding:
            # Native split metadata packages keep optional dependencies in the
            # same -U transaction as the prepared desktop/login archives.
            packages = ["icewine-login"]
            utilities = {"terminal": "terminal", "filemanager": "filemanager",
                         "shellExtras": "shell-extras", "texteditor": "editor",
                         "screenshot": "screenshot", "media": "media", "gamescope": "gamescope"}
            packages += ["icewine-" + package for feature, package in utilities.items() if selected[feature]]
            if selected["steam"] != "none":
                packages.append("icewine-steam-" + selected["steam"])
        local = []
        package_dir = os.environ.get("ICEWINE_PACKAGE_DIR")
        for package in (list(packages) if onboarding else ("icewine-session", "icewine-handheld", "icewine-keyboard", "icewine-controller-idle", "icewine-login")):
            if package not in packages:
                continue
            archives = sorted(path for path in Path(package_dir).glob(package + "-[0-9]*.pkg.tar.*") if path.suffix != ".sig") if package_dir else []
            if len(archives) > 1 or (onboarding and (len(archives) != 1 or not archives[0].is_file() or archives[0].is_symlink())):
                raise ValueError(f"expected one {package} archive in {package_dir}")
            if archives:
                # Prepared source takes precedence even at the same package version.
                local.append(str(archives[0].resolve()))
                packages.remove(package)
            elif subprocess.run(["pacman", "-Qq", package], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                packages.remove(package)
        if packages:
            run(["sudo", "pacman", "-S", "--needed", *packages])
        if local:
            run(["sudo", "pacman", "-U", *local])
        if selected["steam"] == "flatpak" or selected["screenshot"] or selected["media"]:
            run(["flatpak", "remote-add", "--user", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"])
            apps = (["com.valvesoftware.Steam"] if selected["steam"] == "flatpak" else []) + (["be.alexandervanhee.gradia"] if selected["screenshot"] else [])
            apps += ["org.videolan.VLC"] if selected["media"] else []
            run(["flatpak", "install", "--user", "--noninteractive", "flathub", *apps])
    runtime_unit = None
    # Each onboarding session starts optional runtime off, even when a previous
    # successful Apply saved the same choices. Confirm them in this session too.
    changed = onboarding or any(applied[name] != selected[name] for name in ("steam", "gamescope", "handheld")) or selected["handheld"] or (state / "handheld-rules.sha256").exists()
    try:
        if not readonly and changed:
            # The native target Requires the shell: stopping just the shell also
            # stops the target and its PartOf helpers. Restore the active group.
            # A standalone shell still has its original, narrower lifecycle.
            for unit in ("icewine-session.target", "icewine.service"):
                if subprocess.run(["systemctl", "--user", "is-active", "--quiet", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                    runtime_unit = unit
                    break
            if runtime_unit:
                run(["systemctl", "--user", "stop", runtime_unit])
            if applied["handheld"] or (state / "handheld-rules.sha256").exists():
                # Stop routing before removing its permission; ExecStopPost restores
                # controller defaults even after a failed oneshot start.
                run(["systemctl", "--user", "disable", "--now", *HANDHELD_UNITS])
            if applied["gamescope"] and changed and subprocess.run(["systemctl", "--user", "is-active", "--quiet", "icewine-steam-gamescope.service"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
                run(["systemctl", "--user", "stop", "icewine-steam-gamescope.service"])
        if not readonly and (selected["handheld"] or applied["handheld"] or (state / "handheld-rules.sha256").exists()):
            handheld_policy(state, selected["handheld"])
        defaults = os.environ.get("ICEWINE_DEFAULT_FILES", "/usr/share/icewine/defaults")
        if not readonly and selected["handheld"]:
            defaults = os.environ.get("ICEWINE_HANDHELD_DEFAULT_FILES", "/usr/share/icewine/defaults-handheld")
        if not (Path(defaults) / "config").is_dir() or not (Path(defaults) / "data").is_dir():
            raise ValueError(f"Icewine default files are unavailable: {defaults}")
        assets = Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine/theme"))
        themes = theme.installed(assets)
        theme_id, _ = theme.effective(state, themes)
        files = theme.render_theme(assets, themes[theme_id], theme.transparency_level(state))
        if theme.render_readonly(config):
            print("read-only symlink: preserved generated theme configuration", file=sys.stderr)
        else:
            theme.publish(config, files)
        for feature in FEATURES:
            if applied[feature] and not selected[feature]:
                retire(config, data, state, feature)
        for app in ("quickshell", "wallpapers"):
            theme.install_defaults(defaults, config, data, state, overwrite, app)
        # Ponytail: GTK-only Apply is deferred until independently used; then honour its existing gate without changing Arch coupling.
        for feature in FEATURES:
            if not selected[feature]:
                continue
            for app in APPS[feature]:
                theme.install_defaults(defaults, config, data, state, overwrite, app)
                if app in theme.APPS and theme.APPS[app]:
                    theme.install_links(config, state, overwrite, app)
        if selected["filemanager"] and not readonly:
            if any(theme.symlinked(config / name) for name in ("mimeapps.list", "mimeapps.list.new")):
                print(f"read-only symlink: preserved {config / 'mimeapps.list'}", file=sys.stderr)
            elif not any(default_ini(default_read(path)).get("Default Applications", "inode/directory", fallback="").strip("; ")
                         for path in default_paths(config, data)[0]):
                # Initialise only when no explicit XDG directory default exists.
                run(["xdg-mime", "default", "icewine-yazi.desktop", "inode/directory"],
                    env=dict(os.environ, XDG_CURRENT_DESKTOP="X-Generic", DE="generic", XDG_UTILS_INSTALL_MODE="user"))
        if selected["desktop"] and os.environ.get("ICEWINE_GTK_ENABLE", "true") != "false":
            theme.install_gtk_theme(config, theme_id)
        if not readonly and changed:
            session_environment(selected)
            run(["systemctl", "--user", "daemon-reload"])
            if selected["handheld"]:
                run(["sudo", "systemctl", "start", "inputplumber.service"])
                run(["systemctl", "--user", "enable", *HANDHELD_UNITS])
                if runtime_unit:
                    run(["systemctl", "--user", "start", *reversed(HANDHELD_UNITS)])
            if runtime_unit:
                run(["systemctl", "--user", "start", runtime_unit])
    except Exception:
        if not readonly and changed:
            # Leave the shell stopped and routes restored on a failed transition.
            # A retained ownership record makes a later Apply retry teardown.
            if runtime_unit:
                try:
                    run(["systemctl", "--user", "stop", runtime_unit])
                except subprocess.CalledProcessError as error:
                    print(f"Failed to stop Icewine runtime: {error}", file=sys.stderr)
            if selected["handheld"] or applied["handheld"] or (state / "handheld-rules.sha256").exists():
                try:
                    run(["systemctl", "--user", "disable", "--now", *HANDHELD_UNITS])
                    handheld_policy(state, False)
                except (subprocess.CalledProcessError, OSError, ValueError) as error:
                    print(f"Failed Handheld teardown; retry Apply: {error}", file=sys.stderr)
            try:
                session_environment(applied | {"handheld": False})
            except subprocess.CalledProcessError as error:
                print(f"Failed to restore session flags: {error}", file=sys.stderr)
        raise
    if onboarding:
        # Enable for the next boot only; never evict the current TTY login.
        onboarding_login()
        run(["sudo", "systemctl", "daemon-reload"])
        run(["sudo", "systemctl", "enable", "greetd.service"])
        run(["sudo", "systemctl", "set-default", "graphical.target"])
    theme.atomic_text(applied_path, json.dumps(selected, sort_keys=True) + "\n")
    if not readonly:
        theme.atomic_text(state / "manage.json", json.dumps(selected, sort_keys=True) + "\n", setting=True)
    print("Applied Icewine selections. Reopen with icewine; existing dotfiles are preserved by default.")
    if selected["desktop"]:
        print("Keep your fallback desktop. Next login: Hyprland (UWSM) on NixOS; Icewine on Arch/CachyOS, or icewine-session from a logged-in TTY.")
        print("Session diagnosis: journalctl --user -u icewine.service -b")
    if not readonly:
        print("Experimental Arch/CachyOS: installed-session and device qualification remain pending.")


# Default Apps edits standard user preferences only; utility Apply is independent.
DEFAULT_ROLES = ("Browser", "Terminal", "File manager", "Text files", "PDFs", "Images", "Videos", "Audio")
DEFAULT_MIMES = (
    ("x-scheme-handler/http", "x-scheme-handler/https", "text/html"), (),
    ("inode/directory",), ("text/plain",), ("application/pdf",),
    ("image/jpeg", "image/png", "image/gif", "image/webp", "image/avif"),
    ("video/mp4", "video/webm", "video/x-matroska"),
    ("audio/mpeg", "audio/ogg", "audio/flac", "audio/x-wav"),
)


def default_ini(raw):
    if b"\0" in raw:
        raise ValueError("Invalid desktop preference file")
    import configparser
    parser = configparser.ConfigParser(interpolation=None, delimiters=("=",), comment_prefixes=("#",), strict=True, default_section="\0")
    parser.optionxform = str
    try:
        parser.read_string(raw.decode("utf-8"))
        if any("\n" in value for section in parser.sections() for value in parser[section].values()):
            raise ValueError("Multiline desktop preference values are unsupported")
    except (UnicodeError, configparser.Error) as error:
        raise ValueError("Invalid desktop preference file; repair it before saving") from error
    return parser


def default_read(path):
    return path.read_bytes() if path.exists() else b""


def default_paths(config, data):
    desktops = [name.lower() for name in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":")
                if re.fullmatch(r"[A-Za-z0-9_-]+", name)]
    config_dirs = [Path(p) for p in (os.environ.get("XDG_CONFIG_DIRS") or "/etc/xdg").split(":") if p.startswith("/")]
    data_dirs = [Path(p) for p in (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":") if p.startswith("/")]
    names = [name + "-mimeapps.list" for name in desktops] + ["mimeapps.list"]
    users = [directory / name for directory in (config, data / "applications") for name in names]
    paths = [directory / name for directory in (config, *config_dirs, data / "applications", *(p / "applications" for p in data_dirs)) for name in names]
    terminal_names = [name + "-xdg-terminals.list" for name in desktops] + ["xdg-terminals.list"]
    terminal_users = [config / name for name in terminal_names]
    terminals = [directory / name for directory in (config, *config_dirs, *(p / "xdg-terminal-exec" for p in data_dirs)) for name in terminal_names]
    return list(dict.fromkeys(paths)), list(dict.fromkeys(users)), list(dict.fromkeys(terminals)), list(dict.fromkeys(terminal_users)), [data, *data_dirs]


def default_inventory(roots):
    applications, seen, aliases = {}, set(), {}
    for root in roots:
        for line in default_read(root / "mime/aliases").decode("utf-8").splitlines():
            parts = line.split()
            if len(parts) == 2:
                aliases.setdefault(parts[0], parts[1])
        directory = root / "applications"
        for path in sorted(directory.rglob("*.desktop")) if directory.is_dir() else ():
            identifier = path.relative_to(directory).as_posix().replace("/", "-")
            if identifier in seen:
                continue
            seen.add(identifier)  # Hidden/invalid higher-priority entries still mask lower ones.
            if not re.fullmatch(r"[\w.+-]+\.desktop", identifier):
                continue
            try:
                raw = path.read_bytes()
                parser = default_ini(raw)
                entry = dict(parser["Desktop Entry"])
            except (OSError, ValueError, KeyError):
                continue
            if (entry.get("Type") != "Application" or entry.get("Hidden") == "true"
                    or not entry.get("Name") or not (entry.get("Exec") or entry.get("DBusActivatable") == "true")
                    or (entry.get("TryExec") and not shutil.which(entry["TryExec"]))):
                continue
            name = re.sub(r"\\([sntr\\])", lambda m: {"s": " ", "n": "\n", "t": "\t", "r": "\r", "\\": "\\"}[m[1]], entry["Name"])
            name = "".join(c if c.isprintable() else " " for c in name)
            applications[identifier] = {"name": name, "mimes": set(entry.get("MimeType", "").split(";")),
                                        "directory": directory, "terminal": "TerminalEmulator" in entry.get("Categories", "").split(";"),
                                        "raw": raw, "actions": {name[len("Desktop Action "):] for name in parser.sections() if name.startswith("Desktop Action ") and name[len("Desktop Action "):] in entry.get("Actions", "").split(";") and parser.get(name, "Exec", fallback="")}}
    return applications, aliases


def default_owned(path):
    return theme.symlinked(path) is None and not theme.setting_readonly(path)


def default_edit(raw, section, updates):
    # Preserve all non-target lines, including comments and other MIME associations.
    default_ini(raw)
    lines, output, current, remaining = raw.decode("utf-8").splitlines(keepends=True), [], "", dict(updates)
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("["):
            if current == section:
                output.extend(f"{key}={value}\n" for key, value in remaining.items() if value is not None)
                remaining.clear()
            current = stripped[1:-1]
        key, separator, _ = stripped.partition("=")
        if current == section and separator and key.strip() in updates:
            value = remaining.pop(key.strip(), None)
            if value is not None:
                output.append(f"{key.strip()}={value}\n")
        else:
            output.append(line)
    if any(value is not None for value in remaining.values()):
        if output and not output[-1].endswith("\n"):
            output[-1] += "\n"
        if current != section and any(value is not None for value in remaining.values()):
            output.append(f"[{section}]\n")
        output.extend(f"{key}={value}\n" for key, value in remaining.items() if value is not None)
    return "".join(output).encode()


def default_snapshot(path):
    import stat
    try:
        info = path.lstat()
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(info.st_mode):
        raise ValueError(f"Default preference is Read Only: {path}")
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as stream:
        actual = os.fstat(stream.fileno())
        if (info.st_dev, info.st_ino) != (actual.st_dev, actual.st_ino):
            raise ValueError(f"Default preference changed: {path}")
        return (info.st_dev, info.st_ino, info.st_mtime_ns, stat.S_IMODE(info.st_mode), stream.read())


def default_commit(edits, recovering=False, before_commit=None, after_commit=None):
    # Ponytail: bounded per-role files, not a cross-process atomic transaction.
    # Stage before renaming; revision/identity guards protect unrelated writers.
    staged, written = [], []
    try:
        for path, before, contents in edits:
            if not default_owned(path):
                raise ValueError(f"Default preference is Read Only: {path}")
            path.parent.mkdir(parents=True, exist_ok=True)
            theme.writable(path)
            parent = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            temporary = ".icewine-default-" + os.urandom(12).hex()
            item = (path, before, contents, parent, temporary, None)
            staged.append(item)
            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=parent)
            with os.fdopen(fd, "wb") as stream:
                stream.write(contents)
                os.fchmod(stream.fileno(), before[3] if before else 0o600)
                stream.flush()
                os.fsync(stream.fileno())
                info = os.fstat(stream.fileno())
                expected = (info.st_dev, info.st_ino, info.st_mtime_ns, info.st_mode & 0o7777, contents)
                staged[-1] = (path, before, contents, parent, temporary, expected)
        if before_commit is not None:
            before_commit()
        for path, before, contents, parent, temporary, expected in staged:
            theme.writable(path)
            directory = path.parent.stat()
            pinned = os.fstat(parent)
            if ((directory.st_dev, directory.st_ino) != (pinned.st_dev, pinned.st_ino)
                    or default_snapshot(path) != before or not default_owned(path)):
                raise ValueError(f"Default preference changed before saving: {path}")
            os.replace(temporary, path.name, src_dir_fd=parent, dst_dir_fd=parent)
            written.append((path, before, expected))
            os.fsync(parent)
        if after_commit is not None:
            after_commit()
    except (OSError, ValueError) as error:
        if recovering:
            raise
        failures = []
        for path, before, after in reversed(written):
            try:
                if not default_owned(path) or default_snapshot(path) != after:
                    raise ValueError("changed by another writer")
                if before is None:
                    parent = next(item[3] for item in staged if item[0] == path)
                    os.unlink(path.name, dir_fd=parent)
                else:
                    # Restore through the same guarded path, without overwriting newer edits.
                    default_commit([(path, after, before[4])], recovering=True)
            except (OSError, ValueError) as recovery:
                failures.append(f"{path}: {recovery}")
        if failures:
            raise ValueError("Couldn’t save default application; recovery needs attention: " + "; ".join(failures)) from error
        raise ValueError("Couldn’t save default application. Previous settings retained.") from error
    finally:
        for _, _, _, parent, temporary, _ in staged:
            try:
                os.unlink(temporary, dir_fd=parent)
            except FileNotFoundError:
                pass
            os.close(parent)


def default_terminal_id():
    tool = shutil.which("xdg-terminal-exec")
    if not tool:
        return ""
    # Some versions remove a disabled cache; isolate it even for a read-only query.
    with tempfile.TemporaryDirectory(prefix="icewine-terminal-query-") as cache:
        try:
            response = subprocess.run([tool, "--print-id"], capture_output=True, text=True, timeout=5,
                                      env=dict(os.environ, XTE_CACHE_ENABLED="0", XDG_CACHE_HOME=cache))
            return response.stdout.strip() if response.returncode == 0 else ""
        except (OSError, subprocess.SubprocessError):
            return ""


def default_apps_state(config, data):
    paths, users, terminals, terminal_users, roots = default_paths(config, data)
    apps, aliases = default_inventory(roots)
    raw = {path: default_read(path) for path in dict.fromkeys([*paths, *terminals])}
    documents = [(path, default_ini(raw[path])) for path in paths]
    canonical = lambda mime: aliases.get(mime, mime)
    def supported(identifier, mime):
        for path, document in documents:
            if path.name != "mimeapps.list":
                continue  # Desktop-specific files cannot add/remove associations.
            for section, answer in (("Added Associations", True), ("Removed Associations", False)):
                if identifier in document.get(section, mime, fallback="").split(";"):
                    return answer
            if path.parent == apps[identifier]["directory"]:
                break  # Lower directories cannot change the winning desktop entry.
        return canonical(mime) in {canonical(value) for value in apps[identifier]["mimes"]}
    def configured(mime):
        for _, document in documents:
            ids = [value for value in document.get("Default Applications", mime, fallback="").split(";") if value]
            if ids:
                identifier = ids[0]
                return identifier, identifier in apps and supported(identifier, mime)
        return "", False
    values = [[configured(mime) for mime in group] for group in DEFAULT_MIMES]
    browser = values[0][0][0] if len(set(values[0])) == 1 and values[0][0][1] else ""
    digest = hashlib.sha256()
    for path, contents in raw.items():
        digest.update(str(path).encode() + b"\0" + contents + b"\0")
        info = path.lstat() if path.exists() or path.is_symlink() else None
        digest.update(str((info.st_dev, info.st_ino, info.st_mode, info.st_mtime_ns, info.st_size) if info else None).encode())
    for identifier, app in sorted(apps.items()):
        digest.update(identifier.encode() + b"\0" + str(app["directory"]).encode() + b"\0" + app["raw"])
    digest.update(json.dumps(aliases, sort_keys=True).encode())
    terminal_tool = shutil.which("xdg-terminal-exec")
    digest.update(str(terminal_tool).encode())
    revision = digest.hexdigest()
    result = []
    for index, group in enumerate(DEFAULT_MIMES):
        mixed = index != 1 and len(set(values[index])) != 1
        choices = [(identifier, app["name"]) for identifier, app in apps.items()
                   if (app["terminal"] if index == 1 else all(supported(identifier, mime) for mime in group))]
        counts = {}
        for _, name in choices:
            counts[name] = counts.get(name, 0) + 1
        choices = [(identifier, name + (" (" + identifier + ")" if counts[name] > 1 else "")) for identifier, name in choices]
        choices.sort(key=lambda pair: (pair[1].casefold(), pair[0]))
        current, label = "", "Not set"
        if index == 1:
            ids = [line.strip() for path in terminals for line in raw[path].decode("utf-8").splitlines()
                   if line.strip() and not line.strip().startswith(("#", "+", "-", "/"))]
            current = ids[0] if ids else ""
            if not current and terminal_tool:
                current = default_terminal_id()
            base, _, action = current.partition(":")
            valid = base in apps and apps[base]["terminal"] and (not action or action in apps[base]["actions"])
            label = (apps[base]["name"] + (" / " + action if action else "")) if valid else "Missing: " + current if current else "Not set"
            if current and action and valid:
                choices.insert(0, (current, label))
            readonly = not terminal_tool or any(not default_owned(path) for path in terminal_users)
        else:
            entries = values[index]
            if mixed:
                label = "Mixed"
            else:
                current, valid = entries[0]
                label = apps[current]["name"] if valid else "Missing: " + current if current else "Not set"
            readonly = not default_owned(config / "mimeapps.list") or any(
                not default_owned(path) and any(document.get("Default Applications", mime, fallback="") for mime in group)
                for path, document in documents if path in users)
        if index == 4:
            choices.insert(0, ("@browser", "Default (browser)"))
            if browser and current == browser and values[4][0][1]:
                current, label = "@browser", "Default (browser)"
        choices.append(("@unset", "Not set"))
        result.append({"label": label, "current": "" if mixed else current or "@unset", "readonly": readonly,
                       "choices": choices, "revision": revision, "browser": browser})
    return result


def default_apps(argv, config, data, state):
    if argv == ["default-apps-state"]:
        for index, role in enumerate(default_apps_state(config, data)):
            encode = lambda value: value.encode("utf-8").hex()
            print(index, str(role["readonly"]).lower(), role["revision"], encode(role["label"]), encode(role["current"]),
                  ",".join(encode(identifier) + ":" + encode(name) for identifier, name in role["choices"]), sep="\t")
        return
    if len(argv) != 4 or argv[0] != "default-apps-apply" or argv[2] not in {str(i) for i in range(8)}:
        raise ValueError("Invalid Default Apps request")
    if os.getuid() == 0:
        raise ValueError("run icewine as your desktop user")
    state = state.resolve()
    lock_path = state / "defaults.lock"
    theme.writable(lock_path)
    state.mkdir(parents=True, exist_ok=True)
    with os.fdopen(os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600), "r+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        index, choice = int(argv[2]), argv[3]
        role = default_apps_state(config, data)[index]
        if role["revision"] != argv[1]:
            raise ValueError("Default applications changed; reopen the chooser before saving")
        if role["readonly"]:
            raise ValueError("Default application is Read Only")
        if choice not in dict(role["choices"]):
            raise ValueError("Application is no longer available for this role")
        if choice == "@browser":
            choice = role["browser"]
            if not choice:
                raise ValueError("Choose a browser first.")
        needs_association = choice not in dict(role["choices"]) and choice != "@unset"
        _, users, _, terminal_users, _ = default_paths(config, data)
        terminal_fallbacks = list(dict.fromkeys(line.strip() for path in terminal_users for line in default_read(path).decode("utf-8").splitlines()
                                                if line.strip() and not line.strip().startswith(("#", "+", "-", "/")) and line.strip() != choice))
        paths = terminal_users if index == 1 else users
        edits = []
        for path in paths:
            raw = default_read(path)
            if index == 1:
                contents = "".join(line for line in raw.decode("utf-8").splitlines(keepends=True)
                                   if not line.strip() or line.strip().startswith(("#", "+", "-", "/"))).encode()
                if path == config / "xdg-terminals.list" and choice != "@unset":
                    contents = ("\n".join([choice, *terminal_fallbacks]) + "\n").encode() + contents
            else:
                updates = {mime: choice + ";" if path == config / "mimeapps.list" and choice != "@unset" else None for mime in DEFAULT_MIMES[index]}
                contents = default_edit(raw, "Default Applications", updates)
                if path == config / "mimeapps.list" and needs_association:
                    document = default_ini(contents)
                    for mime in DEFAULT_MIMES[index]:
                        associated = [value for value in document.get("Added Associations", mime, fallback="").split(";") if value]
                        if choice not in associated:
                            associated.append(choice)
                        contents = default_edit(contents, "Added Associations", {mime: ";".join(associated) + ";"})
                        removed = [value for value in document.get("Removed Associations", mime, fallback="").split(";") if value and value != choice]
                        contents = default_edit(contents, "Removed Associations", {mime: ";".join(removed) + ";" if removed else None})
            if contents != raw:
                before = default_snapshot(path)
                if (before[4] if before else b"") != raw:
                    raise ValueError("Default applications changed before saving")
                edits.append((path, before, contents))
        def current():
            if default_apps_state(config, data)[index]["revision"] != role["revision"]:
                raise ValueError("Default applications changed before saving")
        def selected_terminal():
            if index == 1 and choice != "@unset" and default_terminal_id() != choice:
                raise ValueError("Terminal helper could not select this application")
        default_commit(edits, before_commit=current, after_commit=selected_terminal)
        print("Default application saved")


def main(argv):
    config, data = theme.xdg("XDG_CONFIG_HOME", ".config"), theme.xdg("XDG_DATA_HOME", ".local/share")
    state = theme.xdg("XDG_STATE_HOME", ".local/state") / "icewine"
    if argv and argv[0] in {"default-apps-state", "default-apps-apply"}:
        default_apps(argv, config, data, state)
        return
    if argv == ["hotkeys-state"]:
        hotkeys(argv, state)
        return
    if argv == ["widget-icons"]:
        try:
            result = subprocess.run(["qs", "ipc", "call", "topbar", "icons"], capture_output=True, text=True, timeout=2)
            if result.returncode == 0:
                # Only transport printable single glyphs for known modules.
                fields = dict(field.split("=", 1) for field in result.stdout.split())
                if set(fields) == set(CARD_MODULES) and all(len(value) == 1 and value.isprintable() for value in fields.values()):
                    print(result.stdout.strip())
                    return
        except (OSError, ValueError, subprocess.SubprocessError):
            pass
        assets = Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine/theme"))
        themes = theme.installed(assets)
        theme_id, _ = theme.effective(state, themes)
        glyph = json.loads(theme.render_theme(assets, themes[theme_id])["palette.json"])["osGlyph"]
        print(" ".join(f"{name}={icon}" for name, icon in zip(CARD_MODULES,
            (glyph, "󰀻", "󰕰", "", "", "", "󰅌", "󰯡", "󰒍", "󰣀", "󰂜", "󰐥", "󰓅"))))
        return
    if len(argv) == 2 and argv[0] == "theme-preview":
        assets = Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine/theme"))
        themes = theme.installed(assets)
        if argv[1] not in themes:
            raise ValueError("theme is not installed")
        palette = json.loads(theme.render_theme(assets, themes[argv[1]], theme.transparency_level(state))["palette.json"])
        print(" ".join(f"{name}={palette[name]}" for name in ("primary", "foreground", "background", "muted", "secondary", "tertiary")))
        return
    if argv in (["screenshot"], ["screenshot", "screen"]):
        _, selected = selections(state)
        if not selected["screenshot"]:
            raise ValueError("Screenshot is disabled in Utilities")
        try:
            run(["qs", "ipc", "call", "topbar", "capture"])
            run(["flatpak", "run", "be.alexandervanhee.gradia", "--screenshot=FULL"])
        except (OSError, subprocess.SubprocessError) as error:
            raise ValueError("Gradia capture failed; check Icewine shell, Flatpak installation and screenshot portal: " + str(error)) from error
        return
    if argv == ["appearance-state"]:
        themes = theme.installed(Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine")))
        if theme.DEFAULT not in themes:
            raise ValueError("Tokyo Night assets are missing")
        selected, policy = theme.effective(state, themes)
        render = theme.render_readonly(config)
        wallpaper_data = Path(os.environ.get("ICEWINE_WALLPAPER_DATA_HOME") or data)
        fields = {
            "themes": ",".join(sorted(themes)), "selected": selected,
            "policy": str(policy).lower(), "level": theme.transparency_level(state),
            "desktopLayout": theme.layout_default(state),
        }
        fields.update({name: str(bool(link)).lower() for name, link in {
            "theme": theme.setting_readonly(state / "theme") or render,
            "transparency": theme.setting_readonly(state / "transparency") or render,
            "wallpaper": theme.setting_readonly(wallpaper_data / "icewine/wallpapers/selection.img"),
            "monitors": theme.setting_readonly(config / "hypr/hyprland.lua") or theme.setting_readonly(config / "hypr/hyprmon.lua"),
            "layout": theme.setting_readonly(state / "layout"),
        }.items()})
        print(" ".join(f"{name}={value}" for name, value in fields.items()))
        return
    if argv == ["widgets-state"]:
        widgets(argv, config, state)
        return
    hotkey_request = bool(argv) and argv[0] == "hotkeys-apply"
    widget_request = bool(argv) and argv[0] == "widgets-apply"
    prepare_request = argv == ["onboarding-prepare"]
    readonly, previous = selections(state) if not (widget_request or hotkey_request or prepare_request) else (False, {})
    if argv == ["state"]:
        print(" ".join(f"{name}={str(bit).lower()}" for name, bit in {"readonly": readonly, **previous}.items()))
        return
    if not (widget_request or hotkey_request or prepare_request) and (not argv or argv[0] != "apply"):
        raise ValueError("invalid manager request")
    if not (widget_request or hotkey_request or prepare_request):
        fields = {}
        for field in argv[1:]:
            name, separator, value = field.partition("=")
            if not separator or name in fields or value not in ({"none", "native", "flatpak"} if name == "steam" else {"true", "false"}):
                raise ValueError("invalid manager request")
            fields[name] = value if name == "steam" else value == "true"
        if "overwrite" not in fields:
            raise ValueError("missing overwrite choice")
        overwrite = fields.pop("overwrite")
        selected = validate(fields)
    if os.getuid() == 0:
        raise ValueError("run icewine as your desktop user")
    lock_path = (state.resolve() if widget_request or hotkey_request else state) / "defaults.lock"
    theme.writable(lock_path)
    state.mkdir(parents=True, exist_ok=True)
    fd = os.open(lock_path, os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "r+") as lock:
        # Ponytail: one lock serialises explicit Apply; split by root if contention matters.
        fcntl.flock(lock, fcntl.LOCK_EX)
        if prepare_request:
            prepare_onboarding(config, data, state)
            return
        if hotkey_request:
            hotkeys(argv, state)
            return
        if widget_request:
            widgets(argv, config, state)
            return
        readonly, previous = selections(state)
        apply(selected, overwrite, readonly, previous, config, data, state)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"Icewine Apply failed: {error}", file=sys.stderr)
        if sys.argv[1:2] == ["apply"]:
            retry = "the retained onboard launcher" if os.environ.get("ICEWINE_ONBOARDING") == "1" else "icewine"
            print(f"Earlier packages/files may have changed; no complete rollback occurred. Resolve the error, then reopen {retry} and retry Apply with overwrite off. Keep the local split-package directory available.", file=sys.stderr)
        sys.exit(1)
