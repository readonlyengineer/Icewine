#!/usr/bin/env python3
"""Manage only Icewine's user-owned theme files and selection."""

import configparser
import os
import errno
import fcntl
import hashlib
import json
import re
import secrets
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path


DEFAULT = "catppuccin-mocha"
TRANSPARENCY = {
    "off": ("1.00", "1.00"),
    "low": ("0.80", "0.75"),
    "med": ("0.60", "0.55"),
    "high": ("0.40", "0.40"),
}
CONSUMERS = json.loads((Path(os.environ.get("ICEWINE_THEME_ASSETS", Path(__file__).resolve().parent.parent / "theme/assets"))
                        / "consumers.json").read_text(encoding="utf-8"))
OWNED = {relative: name for files in CONSUMERS.values() for relative, name in files.items()}
APPS = {
    "quickshell": (),
    **{name: tuple(files) for name, files in CONSUMERS.items()},
    "hypr": (),
    "uwsm": (),
    "btop": (),
    "wallpapers": (),
    "user-dirs": (),
    "nvim": (),
    "kitty": (),
    "bash": (),
}
TEMPLATES = {
    "Palette.qml": "Palette.qml.in",
    "Theme.lua": "Theme.lua.in",
    "kitty.conf": "kitty.conf.in",
    "nvim-theme.lua": "nvim-theme.lua.in",
    "kitty-base.conf": "kitty-base.conf",
    "gtk.css": "gtk.css.in",
    "gtk4.css": "gtk4.css.in",
    "gtk-settings.ini": "gtk-settings.ini.in",
    "yazi-theme.toml": "yazi-theme.toml.in",
    "yazi-keymap.toml": "yazi-keymap.toml",
    "fastfetch.jsonc": "fastfetch.jsonc.in",
    "starship.toml": "starship.toml.in",
    "ls-colors.sh": "ls-colors.sh.in",
}
LEGACY_MANAGED = (set(OWNED) - {"gtk-4.0/gtk.css"}) | {"quickshell/theme/Palette.qml"}
LEGACY_UNITS = (
    "icewine.service", "icewine-refresh-flatpak-icons.service",
    "icewine-refresh-flatpak-icons.path", "hyprpolkitagent.service",
    "hypridle.service", "icewine-controller-idle.service",
    "icewine-inputplumber-hyprland.service", "icewine-keyboard.service",
)
STORE_DIR = Path("/nix/store")


def owned(app=None, include_disabled=False):
    skipped = set(filter(None, os.environ.get("ICEWINE_THEME_SKIP", "").split(":")))
    selected = APPS[app] if app else OWNED
    if os.environ.get("ICEWINE_GTK_ENABLE", "true") == "false":
        skipped.update(APPS["gtk"])
    return {relative: OWNED[relative] for relative in selected
            if include_disabled or relative not in skipped}


def xdg(name, fallback):
    value = os.environ.get(name)
    return Path(value if value else Path.home() / fallback).expanduser()


def atomic_text(path, contents, mode=None, *, root=None, signature=None):
    if root is not None and not still_current(path, root, signature):
        raise ValueError(f"default changed before atomic write: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".icewine-", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(contents)
            stream.flush()
            if mode is not None:
                os.fchmod(stream.fileno(), mode)
            os.fsync(stream.fileno())
        if root is not None and not still_current(path, root, signature):
            raise ValueError(f"default changed during atomic write: {path}")
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def atomic_link(path, target, *, root=None, signature=None):
    if root is not None and not still_current(path, root, signature):
        raise ValueError(f"default changed before atomic link: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.parent / (".icewine-" + secrets.token_hex(8))
    try:
        temporary.symlink_to(target)
        if root is not None and not still_current(path, root, signature):
            raise ValueError(f"default changed during atomic link: {path}")
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def installed(assets):
    themes = assets / "themes"
    if not themes.is_dir() or not (assets / "templates").is_dir():
        raise ValueError(f"theme assets are unavailable: {assets}")
    return {
        item.stem: item for item in themes.glob("*.json")
        if re.fullmatch(r"[a-z0-9][a-z0-9-]*", item.stem)
    }


def render(source, values):
    def replace(match):
        key = match.group(1)
        if key not in values:
            raise ValueError(f"unknown template value: {key}")
        return values[key]
    return re.sub(r"@([A-Za-z][A-Za-z0-9]*)@", replace, source)


def gtk_foreground(background, preferred, alternate=None):
    def luminance(color):
        channels = (int(color[i:i + 2], 16) / 255 for i in (0, 2, 4))
        linear = (v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4
                  for v in channels)
        return sum(v * weight for v, weight in zip(linear, (0.2126, 0.7152, 0.0722)))

    bg, fg = luminance(background), luminance(preferred)
    if (max(bg, fg) + 0.05) / (min(bg, fg) + 0.05) >= 4.5:
        return preferred
    if alternate is not None:
        other = luminance(alternate)
        if (max(bg, other) + 0.05) / (min(bg, other) + 0.05) >= 4.5:
            return alternate
    return "000000" if bg >= 0.175 else "ffffff"


def render_theme(assets, palette_file, level="high"):
    palette = json.loads(palette_file.read_text(encoding="utf-8"))
    if not isinstance(palette, dict) or not all(isinstance(value, str) for value in palette.values()):
        raise ValueError(f"invalid theme data: {palette_file}")
    values = dict(palette)
    values["themeId"] = palette_file.stem
    # Smoky glass: 88% dark base and 12% black; no added accent tint.
    values["terminalBackground"] = "".join(
        f"{round(int(values['backgroundDark'][i:i + 2], 16) * 0.88):02x}"
        for i in (0, 2, 4)
    )
    values["kittyOpacity"], values["inactiveOpacity"] = TRANSPARENCY[level]
    values["gtkPreferDark"] = "0" if values["appearance"] == "light" else "1"
    for role, source in (("gtkAccentFg", "highlight"), ("gtkSuccessFg", "success"),
                         ("gtkWarningFg", "caution"), ("gtkErrorFg", "error")):
        values[role] = gtk_foreground(values[source], values["backgroundDark"])
    values["gtkButtonHoverFg"] = gtk_foreground(values["border"], values["foreground"])
    values["gtkHeaderbarFg"] = gtk_foreground(
        values["backgroundDark"], values["highlight"], values["foreground"])
    values["gtkHeaderbarHoverFg"] = gtk_foreground(
        values["surface"], values["highlight"], values["foreground"])
    for key in ("highlightRgb", "mutedRgb"):
        values[key.removesuffix("Rgb") + "Sgr"] = values[key].replace(", ", ";")
    git_enabled = os.environ.get("ICEWINE_THEME_GIT_ENABLE", "true") == "true"
    values["gitFormat"] = "$git_branch$git_commit$git_state$git_metrics$git_status" if git_enabled else ""
    values["gitDisabled"] = "false" if git_enabled else "true"
    templates = assets / "templates"
    last_modified = os.environ.get("ICEWINE_NIXPKGS_LAST_MODIFIED")
    if last_modified is not None and not re.fullmatch(r"[0-9]+", last_modified):
        raise ValueError("invalid Nixpkgs timestamp")
    kernel = "kernel-nix.sh" if last_modified is not None else "kernel.sh"
    values["kernelCommandJson"] = json.dumps((templates / kernel).read_text(encoding="utf-8"))
    values["nixpkgsRow"] = ""
    if last_modified is not None:
        values["nixpkgsLastModified"] = last_modified
        age_command = render((templates / "nixpkgs-age.sh.in").read_text(encoding="utf-8"), values)
        values["nixpkgsCommandJson"] = json.dumps(age_command)
        values["nixpkgsRow"] = render((templates / "fastfetch-nixpkgs-row.json.in").read_text(encoding="utf-8"), values)
    files = {name: render((templates / template).read_text(encoding="utf-8"), values)
             for name, template in TEMPLATES.items()}
    files["palette.json"] = json.dumps({
        "themeId": palette_file.stem,
        "dark": values["appearance"] != "light",
        **{name: values[source] for name, source in {
            "background": "background", "backgroundDark": "backgroundDark",
            "surface": "surface", "selection": "selection", "border": "border",
            "foreground": "foreground", "foregroundDark": "foregroundDark",
            "muted": "muted", "primary": "highlight", "primaryDark": "highlightDark",
            "secondary": "secondaryHighlight", "tertiary": "tertiaryHighlight",
            "success": "success", "warning": "warning", "caution": "caution",
            "error": "error", "info": "info",
        }.items()},
    }, sort_keys=True) + "\n"
    files["gtk4-settings.ini"] = files["gtk-settings.ini"]
    files["gtk4.css"] = files["gtk.css"] + files["gtk4.css"]
    files["gtk-settings.ini"] = files["gtk-settings.ini"].replace(
        "gtk-theme-name=Adwaita", "gtk-theme-name=Icewine-" + palette_file.stem
    )
    variant = "-dark" if values["appearance"] == "dark" else ""
    files["gtk3-theme.css"] = (
        f'@import url("resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained{variant}.css");\n'
        + files["gtk.css"]
        + render((templates / "gtk3-widgets.css.in").read_text(encoding="utf-8"), values)
    )
    json.loads(files["fastfetch.jsonc"])
    return files


def selection(state):
    path = state / "theme"
    if not path.exists():
        return None
    value = path.read_text(encoding="utf-8").strip()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", value):
        raise ValueError(f"invalid saved theme ID in {path}")
    return value


def transparency_level(state):
    path = state / "transparency"
    level = path.read_text(encoding="utf-8").strip() if path.exists() else "high"
    if level not in TRANSPARENCY:
        raise ValueError(f"invalid saved transparency in {path}; choose off, low, med or high")
    return level


def effective(state, themes):
    policy = os.environ.get("ICEWINE_THEME_POLICY", "")
    for theme_id in (policy, selection(state) if not policy else None, DEFAULT):
        if theme_id:
            if theme_id not in themes:
                raise ValueError(f"theme is not installed: {theme_id}")
            return theme_id, bool(policy)
    raise AssertionError("unreachable")


def publish(config, files):
    current = config / "icewine/current"
    if current.exists() and not current.is_symlink():
        raise ValueError(f"refusing to replace non-link: {current}")
    root = config / "icewine/rendered"
    root.mkdir(parents=True, exist_ok=True)
    digest = hashlib.sha256("".join(f"{name}\0{files[name]}\0" for name in sorted(files)).encode()).hexdigest()
    destination = root / digest
    if not destination.exists():
        temporary = Path(tempfile.mkdtemp(prefix=".render-", dir=root))
        try:
            for name, contents in files.items():
                (temporary / name).write_text(contents, encoding="utf-8")
                (temporary / name).chmod(0o444)
            try:
                temporary.rename(destination)
            except OSError as error:
                if error.errno not in (errno.EEXIST, errno.ENOTEMPTY):
                    raise
        finally:
            if temporary.exists():
                shutil.rmtree(temporary)
    if not destination.is_dir() or any((destination / name).read_text(encoding="utf-8") != contents
                                        for name, contents in files.items()):
        raise ValueError(f"rendered theme files were modified: {destination}")
    # Old content-addressed generations remain recoverable; prune only with a dedicated lifecycle policy.
    atomic_link(current, destination)


def managed_link(path, config):
    if not path.is_symlink():
        return False
    if (path == config / "gtk-4.0/settings.ini"
            and os.readlink(path) == str(config / "icewine/current/gtk-settings.ini")):
        return True
    if (path == config / "gtk-4.0/gtk.css"
            and os.readlink(path) == str(config / "icewine/current/gtk.css")):
        return True
    try:
        if path.relative_to(config).as_posix() not in LEGACY_MANAGED:
            return False
        relative = path.relative_to(Path.home())
        store_path = Path(os.readlink(path)).relative_to(STORE_DIR)
    except ValueError:
        return False
    return (len(store_path.parts) > 1
            and re.fullmatch(r"[a-z0-9]{32}-home-manager-files", store_path.parts[0]) is not None
            and store_path.parts[1:] == relative.parts)


def install_links(config, state, replace, app=None, install=True):
    if install and not replace:
        migration = [config / relative for relative in owned(app)
                     if managed_link(config / relative, config)]
        backup_owned(config, state, migration, "migration-")
    enabled = owned(app)
    for relative, name in owned(app, include_disabled=True).items():
        defaults = os.environ.get("ICEWINE_DEFAULT_FILES")
        native_css = relative in {"gtk-3.0/gtk.css", "gtk-4.0/gtk.css"}
        writable_css = native_css and defaults and (Path(defaults) / "config" / relative).is_file()
        path = config / relative
        if any(parent.is_symlink() for parent in path.parents if parent != config and config in parent.parents):
            print(f"conflict: preserved symlinked parent: {path}", file=sys.stderr)
            continue
        target = config / "icewine/current" / name
        if relative not in enabled:
            signature = default_signature(path)
            recorded_css = False
            if native_css and path.is_file() and not path.is_symlink():
                entry = default_records(state).get("config", {})
                # Ownership records also track host CSS; only the shipped import
                # stub is Icewine styling. Keep unrelated host rules active.
                # Ponytail: extend recognised stub versions if this format changes.
                stub = ('@import url("icewine/defaults.css");\n'
                        f'@import url("../icewine/current/{name}");\n'
                        '/* Add your overrides below. */\n').encode()
                recorded_css = (entry.get("root") == str(config)
                                and signature == entry.get("files", {}).get(relative)
                                and path.read_bytes() == stub)
            if (recorded_css or (path.is_symlink() and os.readlink(path) == str(target))
                    or managed_link(path, config)):
                backup_owned(config, state, [path], "opt-out-")
                if still_current(path, config, signature):
                    path.unlink()
                    print(f"retired: {path}")
            continue
        if writable_css:
            continue  # Enabled writable CSS belongs to default-file tracking, including reset.
        if not install:
            continue
        if path.is_symlink() and os.readlink(path) == str(target):
            continue
        if path.exists() or path.is_symlink():
            if not replace and not managed_link(path, config):
                if path.is_symlink():
                    print(f"conflict: preserved unrecognized symlink: {path}", file=sys.stderr)
                else:
                    print(f"preserved edited file: {path}")
                continue
            path.unlink()
        atomic_link(path, target)
        print(f"installed: {path}")


def backup_owned(config, state, paths=None, prefix="reset-"):
    existing = paths if paths is not None else [config / relative for relative in owned()
                                                if (config / relative).exists() or (config / relative).is_symlink()]
    if not existing:
        return
    state.mkdir(parents=True, exist_ok=True)
    backup = Path(tempfile.mkdtemp(prefix=prefix, dir=state))
    for path in existing:
        destination = backup / path.relative_to(config)
        destination.parent.mkdir(parents=True, exist_ok=True)
        if path.is_symlink() and not path.exists():
            destination.symlink_to(os.readlink(path))
        else:
            shutil.copy2(path, destination)
        print(f"saved: {path} -> {destination}")


def static_app(root_name, relative):
    if root_name == "home":
        return "bash"
    if root_name == "data":
        return relative.parts[0]
    if relative.parts[:2] == ("icewine", "shell"):
        return "bash"
    return {"hypr": "hypr", "uwsm": "uwsm", "quickshell": "quickshell",
            "kitty": "kitty",
            "gtk-3.0": "gtk", "gtk-4.0": "gtk",
            "btop": "btop", "user-dirs.locale": "user-dirs"}.get(relative.parts[0], relative.parts[0])


def home_manager_hypr_entry(path, config):
    # Exact Home Manager entry provenance establishes ownership independently
    # of comments or loader text. Other paths retain existing migration rules.
    if path != config / "hypr/hyprland.lua" or not path.is_symlink():
        return False
    try:
        target = Path(os.readlink(path)).relative_to(STORE_DIR)
        return (re.fullmatch(r"[a-z0-9]{32}-home-manager-files", target.parts[0]) is not None
                and target.parts[1:] == path.relative_to(Path.home()).parts
                and still_current(path, config, default_signature(path)))
    except (ValueError, IndexError, OSError, UnicodeError):
        return False


def managed_static_link(path, root, root_name):
    if not path.is_symlink():
        return False
    if root_name == "config" and path.relative_to(root).as_posix() in {"gtk-3.0/gtk.css", "gtk-4.0/gtk.css"}:
        names = ("gtk.css", "gtk4.css") if path.parent.name == "gtk-4.0" else ("gtk.css",)
        return os.readlink(path) in {str(root / "icewine/current" / name) for name in names} or managed_link(path, root)
    if root_name == "home" and path.name in {".bashrc", ".profile", ".bash_profile"}:
        if os.readlink(path) == str(xdg("XDG_CONFIG_HOME", ".config") / "icewine/shell" / path.name.lstrip(".")):
            return True
    if (root_name == "config" and path == root / "quickshell/theme/Palette.qml"
            and os.readlink(path) == str(root / "icewine/current/Palette.qml")):
        return True
    try:
        target = Path(os.readlink(path)).relative_to(STORE_DIR)
    except ValueError:
        return False
    if not target.parts or not re.fullmatch(r"[a-z0-9]{32}-.+", target.parts[0]):
        return False
    store_name = target.parts[0][33:]
    relative = path.relative_to(root)
    if store_name == "icewine-steam-mask.desktop":
        return (root_name == "data" and len(target.parts) == 1
                and relative.as_posix() in {"applications/steam.desktop",
                                           "applications/com.valvesoftware.Steam.desktop"})
    if store_name == "home-manager-files":
        try:
            if target.parts[1:] != path.relative_to(Path.home()).parts:
                return False
            if root_name == "data" and relative.as_posix() in {
                "applications/steam.desktop", "applications/com.valvesoftware.Steam.desktop",
                "applications/steam-gamescope.desktop",
            }:
                return pure_legacy_steam_entry(path)
            return True
        except ValueError:
            return False
    if store_name == "icewine-hyprland":
        return root_name == "config" and relative.parts[0] == "hypr"
    names = {
        "config": {"uwsm/env": "env", "quickshell/shell.qml": "shell.qml",
                   "quickshell/adapters": "adapters", "quickshell/modules": "modules",
                   "quickshell/theme/Palette.qml": "Palette.qml",
                   "quickshell/DeckOverlay.qml": "DeckOverlay.qml",
                   "quickshell/DeckMenu.js": "DeckMenu.js",
                   "quickshell/config/qmldir": "qmldir",
                   "quickshell/config/Settings.qml": "Settings.qml",
                   "btop/btop.conf": "btop.conf.in", "user-dirs.locale": "user-dirs.locale",
                   "nvim/init.lua": "init.lua"},
        "home": {},
        "data": {"wallpapers/default.jpg": "tokyo-night-wallpaper.jpg",
                 "wallpapers/current_blurr.jpg": "tokyo-night-lockscreen.jpg"},
    }
    return len(target.parts) == 1 and store_name == names[root_name].get(relative.as_posix())


def pure_legacy_steam_entry(path):
    parser = configparser.ConfigParser(interpolation=None)
    parser.optionxform = str
    try:
        with path.open(encoding="utf-8") as stream:
            parser.read_file(stream)
    except (OSError, UnicodeError, configparser.Error):
        return False
    if parser.defaults() or parser.sections() != ["Desktop Entry"]:
        return False
    entry = dict(parser["Desktop Entry"])
    if path.name != "steam-gamescope.desktop":
        return entry == {"Type": "Application", "Name": "Steam",
                         "NoDisplay": "true", "Hidden": "true"}
    executable = entry.pop("Exec", "")
    icon = entry.pop("Icon", "")
    version = entry.pop("Version", "1.0")
    return (re.fullmatch(r"/nix/store/[a-z0-9]{32}-quickshell-[^/]+/bin/qs ipc call gameLauncher launchSteamGamescope", executable) is not None
            and icon in {"steam", "com.valvesoftware.Steam"} and version == "1.0"
            and entry == {"Type": "Application", "Name": "Steam (Gamescope)",
                          "Comment": "Launch Steam inside monitor-aware Gamescope",
                          "Categories": "Game;", "Terminal": "false"})


def pure_legacy_browser_mime(path):
    parser = configparser.ConfigParser(interpolation=None)
    parser.optionxform = str
    try:
        with path.open(encoding="utf-8") as stream:
            parser.read_file(stream)
    except (OSError, UnicodeError, configparser.Error):
        return False
    browser_types = {"x-scheme-handler/http", "x-scheme-handler/https", "text/html",
                     "application/xhtml+xml", "application/pdf"}
    return (not parser.defaults()
            and set(parser.sections()) <= {"Default Applications", "Added Associations", "Removed Associations"}
            and parser.has_section("Default Applications")
            and set(parser["Default Applications"]) == browser_types
            and all(value in {"firefox.desktop", "firefox.desktop;"}
                    for value in parser["Default Applications"].values())
            and all(not parser[section] for section in ("Added Associations", "Removed Associations")
                    if parser.has_section(section)))


def default_signature(path):
    if path.is_symlink():
        return "link:" + os.readlink(path)
    if path.is_file():
        return "sha256:" + hashlib.sha256(path.read_bytes()).hexdigest()
    return None


def still_current(path, root, signature):
    if (default_signature(path) != signature
            or (signature is None and path.exists())
            or any(parent.is_symlink() or (parent.exists() and not parent.is_dir())
                   for parent in path.parents if parent != root and root in parent.parents)):
        print(f"conflict: preserved default changed during installation: {path}", file=sys.stderr)
        return False
    return True


def default_records(state):
    manifest = state / "default-files.json"
    if manifest.is_symlink():
        raise ValueError(f"refusing symlinked defaults ownership record: {manifest}")
    records = json.loads(manifest.read_text()) if manifest.exists() else {}
    if not isinstance(records, dict) or set(records) - {"config", "data", "home"}:
        raise ValueError(f"invalid defaults ownership record: {manifest}")
    for entry in records.values():
        if (not isinstance(entry, dict) or set(entry) != {"root", "files"}
                or not isinstance(entry["root"], str) or not isinstance(entry["files"], dict)
                or any(not isinstance(name, str) or not name or Path(name).is_absolute()
                       or any(part in {"", ".", ".."} for part in name.split("/"))
                       or not isinstance(value, str)
                       or not (re.fullmatch(r"sha256:[0-9a-f]{64}", value) or value.startswith("link:"))
                       for name, value in entry["files"].items())):
            raise ValueError(f"invalid defaults ownership record: {manifest}")
    return records


LEGACY_IMPLEMENTATION_DIRS = ("quickshell/modules", "quickshell/adapters", "quickshell/theme")
LEGACY_IMPLEMENTATION_FILES = ("quickshell/shell.qml", "quickshell/DeckOverlay.qml", "quickshell/DeckMenu.js",
                               "hypr/hyprland.lua") + tuple("hypr/modules/" + name + ".lua" for name in
                               ("Baseline", "LookAndFeel", "WindowPolicy", "DefaultApps", "Docking", "Deck"))


def legacy_implementation(name):
    return name in LEGACY_IMPLEMENTATION_FILES or any(name.startswith(directory + "/")
                                                     for directory in LEGACY_IMPLEMENTATION_DIRS)


def implementation_preflight(defaults, config, state, app=None, *, records=None, migrating=False):
    if defaults:
        source = Path(defaults) / "config"
        entry = (default_records(state) if records is None else records).get("config", {})
        previous = entry.get("files", {}) if entry.get("root") == str(config) else {}
        # Package links are identity, never writable override hooks. Check before
        # switching any entry during init/reset. Theme-only commands do not switch package links.
        for name in ("gtk-3.0/icewine", "gtk-4.0/icewine", "hypr/icewine", "hypr/hypridle-icewine", "nvim/icewine", "kitty/icewine",
                     "uwsm/icewine", "icewine/shell/icewine"):
            shipped, path = source / name, config / name
            if not shipped.is_symlink() or (app and static_app("config", Path(name)) != app):
                continue
            current = default_signature(path)
            if not still_current(path, config, current) or (current is not None
                    and (current != previous.get(name) or not path.is_symlink())):
                raise ValueError(f"implementation migration blocked: preserved unknown package link {path}; "
                                 "back up and move the conflict before icewine init")
        if (source / "hypr/icewine").is_symlink() and "hypr/icewine" not in previous and app in (None, "hypr"):
            if app:
                raise ValueError("implementation migration requires icewine init without APP; scoped init/reset cannot switch the Hyprland loader")
            path = config / "hypr/hyprland.lua"
            current = default_signature(path)
            if not home_manager_hypr_entry(path, config) and current is not None and (current != previous.get("hypr/hyprland.lua")
                    or not still_current(path, config, current)):
                raise ValueError(f"implementation migration blocked: preserved edited/untracked {path}; "
                                 "replace its ICEWINE_IMPLEMENTATION loader with the neighbouring icewine link, "
                                 "back up and move the old entry, then icewine init")
        # Removed hooks must not become inert edits when the native entry starts
        # loading namespaced shared modules. Custom defaultFiles hooks remain
        # available to a host entry that explicitly loads them.
        starter = source / "hypr/hyprland.lua"
        if (app in (None, "hypr") and starter.is_file()
                and starter.read_text(encoding="utf-8").startswith('require("icewine.icewine")\n')):
            path = config / "hypr/hyprland.lua"
            current = default_signature(path)
            transition = ((source / "hypr/icewine").is_symlink() and "hypr/icewine" not in previous
                          or previous.get("hypr/hyprland.lua") not in (None, default_signature(starter)))
            if transition and home_manager_hypr_entry(path, config):
                # During migration the host must already load the new shared
                # namespace; after it owns the entry, its text is its own policy.
                if not re.search(r"(?m)^\s*require\s*\(\s*(['\"])icewine\.icewine\1\s*\)\s*(?:--.*)?$",
                                 path.read_text(encoding="utf-8")):
                    raise ValueError(f"configuration migration blocked: preserved Home Manager entry {path}; "
                                     "update its loader to require(\"icewine.icewine\") in the host configuration, "
                                     "then activate Home Manager before icewine init; do not remove its entry")
            if (previous.get("hypr/hyprland.lua") != default_signature(starter)
                    and current is not None and current != previous.get("hypr/hyprland.lua")
                    and not home_manager_hypr_entry(path, config)):
                raise ValueError(f"configuration migration blocked: preserved edited/untracked {path}; "
                                 "migrate its loader to require(\"icewine.icewine\") and move old hook overrides "
                                 "into the active entry, then back up and move the old entry before icewine init; "
                                 "reset cannot bypass migration")
            for name in ("Binds", "Autostart", "Theme", "host", "Personal"):
                relative = "hypr/modules/" + name + ".lua"
                path = config / relative
                if not transition and relative not in previous:
                    continue
                if (source / relative).exists() or (source / relative).is_symlink():
                    continue
                current = default_signature(path)
                if current is None:
                    continue
                theme_alias = (name == "Theme" and path.is_symlink()
                               and os.readlink(path) == str(config / "icewine/current/Theme.lua"))
                if not still_current(path, config, current) or (not theme_alias and current != previous.get(relative)):
                    raise ValueError(f"configuration migration blocked: preserved edited/untracked {path}; "
                                     "move its active overrides into hyprland.lua or a module loaded there, "
                                     "then back up and move this retired hook before icewine init; reset cannot bypass migration")
        if ((source / "kitty/icewine").is_symlink() and "kitty/icewine" not in previous
                and not (source / "kitty/host.conf").is_file() and app in (None, "kitty")):
            path = config / "kitty/host.conf"
            if path.exists() or path.is_symlink():
                if not still_current(path, config, default_signature(path)) or not path.is_file() or path.read_bytes():
                    raise ValueError(f"configuration migration blocked: preserved {path}; move its overrides "
                                     "after the includes in kitty.conf, back up and move host.conf, then icewine init; "
                                     "reset cannot bypass active overrides")
    if app not in (None, "hypr", "quickshell") or not defaults or not (Path(defaults) / "config/quickshell/icewine").is_symlink():
        return
    entry = (default_records(state) if records is None else records).get("config", {})
    previous = entry.get("files", {}) if entry.get("root") == str(config) else {}
    if app and "quickshell/icewine" not in previous:
        raise ValueError("implementation migration requires icewine init without APP; scoped init/reset cannot switch only one entry point")
    marker = config / "quickshell/icewine"
    conflicts = []
    # This link is the immutable implementation boundary, including after migration.
    if not still_current(marker, config, default_signature(marker)) or (
            (marker.exists() or marker.is_symlink())
            and (default_signature(marker) != previous.get("quickshell/icewine") or not marker.is_symlink())):
        conflicts.append(marker)
    if migrating or "quickshell/icewine" not in previous:
        legacy = dict.fromkeys((*LEGACY_IMPLEMENTATION_FILES, *LEGACY_IMPLEMENTATION_DIRS,
                                *(name for name in previous if legacy_implementation(name))))
        for name in legacy:
            path = config / name
            if home_manager_hypr_entry(path, config):
                continue
            # Do not follow an unknown container into user data.
            if path.is_dir() and not path.is_symlink():
                if name not in LEGACY_IMPLEMENTATION_DIRS:
                    conflicts.append(path)
                    continue
                candidates = [item for item in path.rglob("*") if not item.is_dir() or item.is_symlink()]
            else:
                if not still_current(path, config, default_signature(path)):
                    conflicts.append(path)
                    continue
                candidates = [path] if path.exists() or path.is_symlink() else []
            for item in candidates:
                relative = item.relative_to(config).as_posix()
                if (not still_current(item, config, default_signature(item))
                        or default_signature(item) != previous.get(relative)):
                    conflicts.append(item)
    if conflicts:
        names = "\n  ".join(str(path) for path in dict.fromkeys(conflicts))
        raise ValueError("implementation migration blocked; preserved existing entry points and code:\n  " + names
                         + "\nBack up these paths, migrate Settings/Binds/Autostart or local entry-point hooks, "
                         "then move the conflicting legacy implementation out of the configuration and retry icewine init. "
                         "Do not use reset to bypass migration; current legacy code remains in place.")


def install_defaults(defaults, config, data, state, replace, app):
    if not defaults:
        return
    source_root = Path(defaults)
    manifest = state / "default-files.json"
    records = default_records(state)
    implementation_preflight(defaults, config, state, app)
    backup = None
    backed_up = set()

    def save(path, root, root_name, automatic=False):
        nonlocal backup
        if path in backed_up:
            return
        if backup is None:
            state.mkdir(parents=True, exist_ok=True)
            backup = Path(tempfile.mkdtemp(prefix="defaults-update-" if automatic else ("defaults-reset-" if replace else "defaults-migration-"), dir=state))
        destination = backup / root_name / path.relative_to(root)
        destination.parent.mkdir(parents=True, exist_ok=True)
        signature = default_signature(path)
        if root_name == "config" and (path.name == "icewine" or path.name == "hypridle-icewine") and path.is_symlink():
            destination.symlink_to(os.readlink(path))
        elif path.is_dir():
            shutil.copytree(path, destination)
        elif path.exists():
            shutil.copy2(path, destination)
        else:
            destination.symlink_to(os.readlink(path))
        if signature and signature.startswith("sha256:") and default_signature(destination) != signature:
            raise ValueError(f"defaults backup changed during copying; preserved {path}: {destination}")
        backed_up.add(path)
        print(f"saved: {path} -> {destination}")

    for root_name, root in (("config", config), ("data", data), ("home", Path.home())):
        source = source_root / root_name
        if not source.is_dir() and root_name != "home":
            raise ValueError(f"default files are unavailable: {source}")
        if records.get(root_name, {}).get("root") != str(root):
            records[root_name] = {"root": str(root), "files": {}}
        previous = records[root_name]["files"]
        shipped_files = sorted(item for item in source.rglob("*")
                               if (item.is_file() or item.is_symlink())
                               and (not app or static_app(root_name, item.relative_to(source)) == app))
        present = {item.relative_to(source).as_posix() for item in shipped_files}
        first_quickshell = "quickshell/icewine" in present and "quickshell/icewine" not in previous
        first_hyprland = "hypr/icewine" in present and "hypr/icewine" not in previous
        if root_name == "config" and not app and (first_quickshell or first_hyprland):
            # Ponytail: these loaders switch individually, not atomically
            # across a running session. Finish editing before init; detected
            # conflicts retain backups and roll back unchanged paths only. Use an
            # offline migration if runtime observers must not see intermediate loaders.
            loaders = (("hypr/icewine",) if first_hyprland else ())
            if not home_manager_hypr_entry(config / "hypr/hyprland.lua", config):
                loaders += ("hypr/hyprland.lua",)
            if first_quickshell:
                loaders += ("quickshell/shell.qml", "quickshell/icewine")
            retiring = sorted(name for name in set(previous) - present if legacy_implementation(name))
            original = previous.copy()
            removed, switched = [], {}
            try:
                for name in (*retiring, *loaders):
                    path = root / name
                    if not still_current(path, root, original.get(name) if path.exists() or path.is_symlink() else None):
                        raise ValueError(f"implementation changed before migration: {path}")
                    if path.exists() or path.is_symlink():
                        save(path, root, root_name, automatic=True)
                implementation_preflight(defaults, config, state, records=records, migrating=True)
                for name in retiring:
                    path = root / name
                    if not still_current(path, root, original[name] if path in backed_up else None):
                        raise ValueError(f"implementation changed during migration: {path}")
                    if path.exists() or path.is_symlink():
                        path.unlink()
                        removed.append(name)
                implementation_preflight(defaults, config, state, records=records, migrating=True)
                for name in loaders:
                    path, shipped = root / name, source / name
                    implementation_preflight(defaults, config, state, records=records, migrating=True)
                    current = original.get(name) if path in backed_up else None
                    if shipped.is_symlink():
                        target = config / os.readlink(shipped)
                        atomic_link(path, target, root=root, signature=current)
                        expected = "link:" + str(target)
                    else:
                        atomic_text(path, shipped.read_text(encoding="utf-8"), 0o644, root=root, signature=current)
                        expected = default_signature(shipped)
                    switched[name] = expected
                    previous[name] = expected
                implementation_preflight(defaults, config, state, records=records, migrating=True)
            except (OSError, ValueError) as error:
                for name, expected in switched.items():
                    path = root / name
                    if not still_current(path, root, expected):
                        continue
                    try:
                        path.unlink()
                    except OSError as restore_error:
                        print(f"conflict: could not retire migration loader {path}: {restore_error}", file=sys.stderr)
                for name in (*removed, *switched):
                    path = root / name
                    if name not in original or not still_current(path, root, None):
                        continue
                    try:
                        if original[name].startswith("link:"):
                            path.symlink_to(original[name].removeprefix("link:"))
                        else:
                            saved_path = backup / root_name / name
                            with saved_path.open("rb") as saved, path.open("xb") as restored:
                                shutil.copyfileobj(saved, restored)
                                os.fchmod(restored.fileno(), saved_path.stat().st_mode & 0o777)
                        print(f"restored: {path}")
                    except OSError as restore_error:
                        print(f"conflict: could not restore legacy implementation {path}: {restore_error}", file=sys.stderr)
                previous.clear()
                previous.update(original)
                raise ValueError(f"implementation migration aborted: {error}; "
                                 f"existing edits remain preserved; recovery backups: {backup}") from error
            for name in retiring:
                del previous[name]
                print(f"retired: {root / name}")
            atomic_text(manifest, json.dumps(records, sort_keys=True) + "\n")
        for name in sorted(set(previous) - present):
            relative = Path(name)
            if app and static_app(root_name, relative) != app:
                continue
            path = root / relative
            if any(parent.is_symlink() or (parent.exists() and not parent.is_dir())
                   for parent in path.parents if parent != root and root in parent.parents):
                print(f"conflict: preserved removed default behind changed parent: {path}", file=sys.stderr)
                continue
            if path.exists() or path.is_symlink():
                if default_signature(path) != previous[name]:
                    print(f"conflict: preserved edited removed default: {path}", file=sys.stderr)
                    continue
                save(path, root, root_name, automatic=True)
                if not still_current(path, root, previous[name]):
                    continue
                try:
                    path.unlink()
                except OSError as error:
                    if error.errno != errno.EBUSY:
                        raise
                    print(f"conflict: preserved mounted removed default: {path}", file=sys.stderr)
                    continue
                print(f"retired: {path}")
            del previous[name]
            atomic_text(manifest, json.dumps(records, sort_keys=True) + "\n")
        for shipped in shipped_files:
            relative = shipped.relative_to(source)
            name = relative.as_posix()
            path = root / relative
            if root_name == "config" and home_manager_hypr_entry(path, config):
                previous.pop(name, None)
                atomic_text(manifest, json.dumps(records, sort_keys=True) + "\n")
                continue
            blocked = False
            for parent in reversed(path.parents):
                if parent == root:
                    continue
                if root not in parent.parents:
                    continue
                if parent.exists() and not parent.is_dir():
                    print(f"conflict: preserved non-directory: {parent}", file=sys.stderr)
                    blocked = True
                    break
                if not parent.is_symlink():
                    continue
                if any(Path(name).is_relative_to(parent.relative_to(root)) for name in previous):
                    print(f"conflict: preserved substituted parent of recorded defaults: {parent}", file=sys.stderr)
                    blocked = True
                    break
                if not managed_static_link(parent, root, root_name):
                    print(f"conflict: preserved unrecognized symlink: {parent}", file=sys.stderr)
                    blocked = True
                    break
                parent_signature = default_signature(parent)
                save(parent, root, root_name)
                if not still_current(parent, root, parent_signature):
                    blocked = True
                    break
                parent.unlink()
            if blocked:
                continue
            current = default_signature(path)
            expected = ("link:" + str(config / os.readlink(shipped)) if shipped.is_symlink()
                        else default_signature(shipped))
            unchanged = current is not None and current == previous.get(name)
            if unchanged and current == expected:
                continue
            if path.is_symlink():
                if (current == expected and (unchanged or
                        (name not in previous and managed_static_link(path, root, root_name)))):
                    previous[name] = current
                    continue
                if not unchanged and ((name in previous and not replace)
                                      or not managed_static_link(path, root, root_name)):
                    print(f"conflict: preserved unrecognized symlink: {path}", file=sys.stderr)
                    continue
                save(path, root, root_name, automatic=unchanged and not replace)
            elif path.exists():
                if not path.is_file():
                    print(f"conflict: preserved non-file: {path}; back up and move its remaining contents before retrying init", file=sys.stderr)
                    continue
                if not replace and not unchanged:
                    reason = "edited" if name in previous else "untracked"
                    target_app = static_app(root_name, relative)
                    action = f"icewine reset {target_app}" if target_app in APPS else "icewine reset"
                    print(f"conflict: preserved {reason} default: {path}; compare {shipped} or back up with {action}", file=sys.stderr)
                    continue
                save(path, root, root_name, automatic=unchanged and not replace)
            if not still_current(path, root, current):
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            if shipped.is_symlink():
                if not still_current(path, root, current):
                    continue
                atomic_link(path, config / os.readlink(shipped))
            else:
                fd, temporary = tempfile.mkstemp(prefix=".icewine-", dir=path.parent)
                try:
                    with os.fdopen(fd, "wb") as stream, shipped.open("rb") as source_file:
                        shutil.copyfileobj(source_file, stream)
                        stream.flush()
                        os.fsync(stream.fileno())
                    os.chmod(temporary, 0o644)
                    if not still_current(path, root, current):
                        continue
                    try:
                        os.replace(temporary, path)
                    except OSError as error:
                        if error.errno != errno.EBUSY or path not in backed_up:
                            raise
                        if not still_current(path, root, current):
                            continue
                        # A persisted file bind mount cannot be renamed; its scoped backup is the recovery path.
                        with open(temporary, "rb") as source_file, path.open("wb") as destination:
                            shutil.copyfileobj(source_file, destination)
                            destination.flush()
                            os.fsync(destination.fileno())
                finally:
                    if os.path.exists(temporary):
                        os.unlink(temporary)
            previous[name] = expected
            atomic_text(manifest, json.dumps(records, sort_keys=True) + "\n")
            print(f"installed: {path}")


    # The Gamescope launcher comes from the user profile; Steam masks must
    # outrank Flatpak exports. Local overrides remain user-owned.
    if app is None:
        for root_name, root, relative in (("config", config, "mimeapps.list"),
                                          ("data", data, "applications/mimeapps.list")):
            path = root / relative
            if managed_static_link(path, root, root_name):
                if pure_legacy_browser_mime(path):
                    save(path, root, root_name)
                    path.unlink()
                    print(f"retired: {path}")
                else:
                    print(f"conflict: preserved combined or unreadable Home Manager MIME defaults: {path}",
                          file=sys.stderr)

        for relative in ("applications/steam-gamescope.desktop", "applications/steam.desktop",
                         "applications/com.valvesoftware.Steam.desktop"):
            path = data / relative
            mask = os.environ.get("ICEWINE_STEAM_MASK_FILE") if relative != "applications/steam-gamescope.desktop" else None
            if mask and path.is_symlink() and os.readlink(path) == mask:
                continue
            if any(parent.is_symlink() for parent in path.parents
                   if parent != data and data in parent.parents):
                print(f"conflict: preserved symlinked parent: {path}", file=sys.stderr)
                continue
            if managed_static_link(path, data, "data"):
                save(path, data, "data")
                path.unlink()
                print(f"retired: {path}")
            if mask:
                if path.exists() or path.is_symlink():
                    print(f"conflict: preserved user Steam entry: {path}", file=sys.stderr)
                else:
                    atomic_link(path, Path(mask))
                    print(f"installed: {path}")

        # Home Manager's old unit links override the native NixOS user units.
        # Retire only Icewine's known links, including its generated target links.
        unit_root = config / "systemd/user"
        if not (config / "systemd").is_symlink() and not unit_root.is_symlink() and unit_root.is_dir():
            candidates = [unit_root / name for name in LEGACY_UNITS]
            candidates += [directory / name for directory in unit_root.iterdir()
                           if directory.is_dir() and not directory.is_symlink()
                           and directory.name.endswith((".wants", ".requires"))
                           for name in LEGACY_UNITS]
            retired = False
            for path in candidates:
                if managed_static_link(path, config, "config"):
                    save(path, config, "config")
                    path.unlink()
                    retired = True
                    print(f"retired: {path}")
                elif path.exists() or path.is_symlink():
                    print(f"conflict: preserved user unit link or file: {path}", file=sys.stderr)
            if retired:
                runtime = Path(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}")
                if (runtime / "systemd/private").exists():
                    env = dict(os.environ, XDG_RUNTIME_DIR=str(runtime))
                    try:
                        result = subprocess.run(["systemctl", "--user", "daemon-reload"],
                                                env=env, capture_output=True, text=True)
                        if result.returncode:
                            print(f"Pending: user systemd daemon-reload failed: {result.stderr.strip()}",
                                  file=sys.stderr)
                    except OSError as error:
                        print(f"Pending: user systemd daemon-reload failed: {error}", file=sys.stderr)

    if app in (None, "hypr") and not ((source_root / "config/hypr/modules/Theme.lua").exists()
                                       or (source_root / "config/hypr/modules/Theme.lua").is_symlink()):
        path = config / "hypr/modules/Theme.lua"
        current = default_signature(path)
        if (path.is_symlink() and os.readlink(path) == str(config / "icewine/current/Theme.lua")
                and still_current(path, config, current)):
            save(path, config, "config", automatic=True)
            if still_current(path, config, current):
                path.unlink()
                print(f"retired: {path}")


def install_gtk_theme(config, theme_id):
    path = xdg("XDG_DATA_HOME", ".local/share") / "themes" / ("Icewine-" + theme_id) / "gtk-3.0/gtk.css"
    target = config / "icewine/current/gtk3-theme.css"
    if path.is_symlink() and os.readlink(path) == str(target):
        return
    if path.exists() or path.is_symlink():
        raise ValueError(f"refusing to replace existing GTK theme: {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_link(path, target)


def retire_gtk_theme(config, state, themes):
    data = xdg("XDG_DATA_HOME", ".local/share")
    for theme_id in themes:
        path = data / "themes" / ("Icewine-" + theme_id) / "gtk-3.0/gtk.css"
        if (path.is_symlink() and os.readlink(path) == str(config / "icewine/current/gtk3-theme.css")
                and not any(parent.is_symlink() for parent in path.parents)
                and still_current(path, data, "link:" + str(config / "icewine/current/gtk3-theme.css"))):
            path.unlink()
            print(f"retired: {path}")
    records = state / "flatpak-themes"
    if records.is_dir() and not records.is_symlink():
        for record in records.glob("*/*.sha256"):
            arch, theme_id = record.parent.name, record.stem
            if theme_id not in themes or not re.fullmatch(r"[A-Za-z0-9_]+", arch):
                continue
            path = data / "flatpak/extension" / ("org.gtk.Gtk3theme.Icewine-" + theme_id) / arch / "3.22/gtk.css"
            if any(parent.is_symlink() for parent in (path, record, *path.parents, *record.parents)):
                continue
            record_signature = default_signature(record)
            signature = "sha256:" + record.read_text(encoding="utf-8").strip()
            if (path.is_file() and still_current(record, state, record_signature)
                    and still_current(path, data, signature)):
                path.unlink()
                if still_current(record, state, record_signature):
                    record.unlink()
                print(f"retired: {path}")
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        print("Pending: log into a session to retire the Icewine GTK setting.")
        return True
    try:
        current = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"],
                                 check=True, capture_output=True, text=True, timeout=10).stdout.strip()
        record = state / "gtk-theme"
        previous = record.read_text(encoding="utf-8").strip() if record.is_file() and not record.is_symlink() else None
        record_signature = default_signature(record)
        if previous in {"Icewine-" + theme_id for theme_id in themes} and current == repr(previous):
            subprocess.run(["gsettings", "reset", "org.gnome.desktop.interface", "gtk-theme"],
                           check=True, timeout=10)
            if still_current(record, state, record_signature):
                record.unlink()
        elif current in {f"'Icewine-{theme_id}'" for theme_id in themes}:
            print("Pending: preserved unrecorded GTK selection; select another GTK theme or run gsettings reset org.gnome.desktop.interface gtk-theme.")
    except (OSError, subprocess.SubprocessError) as error:
        print(f"Pending: Icewine GTK setting could not be retired: {error}", file=sys.stderr)
        return False
    # color-scheme has no ownership record; preserve the user's current preference.
    return True


def install_flatpak_theme(state, theme_id, files):
    flatpak = shutil.which("flatpak")
    if not flatpak:
        return
    try:
        arch = subprocess.run([flatpak, "--default-arch"], check=True, capture_output=True,
                              text=True, timeout=10).stdout.strip()
        if not re.fullmatch(r"[A-Za-z0-9_]+", arch):
            raise ValueError("invalid Flatpak architecture")
        # Native architecture only; add runtime-architecture discovery if needed.
        root = xdg("XDG_DATA_HOME", ".local/share") / "flatpak/extension"
        path = root / ("org.gtk.Gtk3theme.Icewine-" + theme_id) / arch / "3.22/gtk.css"
        if any(part.is_symlink() for part in (path, *path.parents)):
            raise ValueError(f"preserving symlinked extension path: {path}")
        record = state / "flatpak-themes" / arch / (theme_id + ".sha256")
        contents = files["gtk3-theme.css"]
        digest = hashlib.sha256(contents.encode("utf-8")).hexdigest()
        if path.exists():
            if not path.is_file():
                raise ValueError(f"preserving non-file extension: {path}")
            current = hashlib.sha256(path.read_bytes()).hexdigest()
            previous = record.read_text(encoding="utf-8").strip() if record.is_file() else None
            if current not in (digest, previous):
                raise ValueError(f"preserving edited extension: {path}")
            if current == digest:
                atomic_text(record, digest + "\n")
                return
        atomic_text(path, contents)
        atomic_text(record, digest + "\n")
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        # Optional Flatpak integration must not prevent the desktop shell starting.
        print(f"pending Flatpak GTK theme: {error}", file=sys.stderr)


def sync_gtk_settings(theme_id, appearance, state):
    if not os.environ.get("DBUS_SESSION_BUS_ADDRESS"):
        return True
    complete = True
    for key, value in (("gtk-theme", "Icewine-" + theme_id),
                       ("color-scheme", "prefer-" + appearance)):
        try:
            subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", key, value],
                           check=True, timeout=10)
            if key == "gtk-theme":
                if (state / "gtk-theme").is_symlink():
                    raise ValueError("refusing symlinked GTK theme ownership record")
                atomic_text(state / "gtk-theme", value + "\n")
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            complete = False
            print(f"Failed: GTK setting {key} was not published: {error}", file=sys.stderr)
    return complete


PROC = Path("/proc")


def signal_reload(name, config, runtime):
    """Request native reload only for this user's default-config processes."""
    if not runtime or not hasattr(os, "pidfd_open") or not hasattr(signal, "pidfd_send_signal"):
        print(f"Pending: {name} native reload is unavailable on this session.", file=sys.stderr)
        return False
    skipped = exited = 0
    failed = False
    try:
        processes = list(PROC.iterdir())
    except OSError as error:
        print(f"Failed: {name} process discovery: {error}", file=sys.stderr)
        return True
    for process in processes:
        if not process.name.isdecimal():
            continue
        try:
            if ((process / "comm").read_bytes().strip() != name.encode() or
                    process.stat().st_uid != os.getuid()):
                continue
        except (OSError, ValueError):
            continue
        try:
            fd = os.pidfd_open(int(process.name))
        except ProcessLookupError:
            exited += 1
            continue
        except OSError as error:
            failed = True
            print(f"Failed: {name} process access for PID {process.name}: {error}", file=sys.stderr)
            continue
        try:
            try:
                if process.stat().st_uid != os.getuid():
                    continue
                args = (process / "cmdline").read_bytes().split(b"\0")
                if not args or Path(os.fsdecode(args[0])).name != name:
                    skipped += 1
                    continue
                options = [os.fsdecode(arg) for arg in args[1:] if arg]
                blocked = ("--config", "--override", "-c", "-o") if name == "kitty" else ("-u", "--clean", "--headless", "--cmd", "--noplugin")
                if any(option == flag or option.startswith(flag + "=") or
                       (flag in ("-c", "-o", "-u") and option.startswith(flag) and option != flag)
                       for option in options for flag in blocked):
                    skipped += 1
                    continue
                env = dict(item.split(b"=", 1) for item in (process / "environ").read_bytes().split(b"\0")
                           if b"=" in item and item.split(b"=", 1)[0] in
                           (b"HOME", b"XDG_CONFIG_HOME", b"XDG_RUNTIME_DIR", b"NVIM_APPNAME"))
                home = os.fsdecode(env.get(b"HOME", b""))
                target_config = os.fsdecode(env.get(b"XDG_CONFIG_HOME", b"")) or (home + "/.config" if home else "")
                if (os.fsdecode(env.get(b"XDG_RUNTIME_DIR", b"")) != runtime or
                        not target_config or Path(target_config).resolve() != config.resolve() or
                        (name == "nvim" and env.get(b"NVIM_APPNAME", b"nvim") != b"nvim")):
                    skipped += 1
                    continue
                signal.pidfd_send_signal(fd, signal.SIGUSR1)
            except ProcessLookupError:
                exited += 1
            except OSError as error:
                failed = True
                print(f"Failed: {name} reload request for PID {process.name}: {error}", file=sys.stderr)
        finally:
            os.close(fd)
    if skipped or exited:
        print(f"Pending: {name} skipped {skipped} unscoped and {exited} exited instance(s).", file=sys.stderr)
    return failed


def reload_session(config, app=None):
    def succeeded(command):
        try:
            return subprocess.run(command, check=False, stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL, timeout=5).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False

    failed = False
    if app in (None, "hypr"):
        if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
            if not succeeded(["hyprctl", "reload"]):
                print("Failed: Hyprland reload request was not delivered.", file=sys.stderr)
                failed = True
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if app in (None, "kitty"):
        failed = signal_reload("kitty", config, runtime) or failed
    if app in (None, "nvim"):
        failed = signal_reload("nvim", config, runtime) or failed
    if app in (None, "yazi") and shutil.which("ya"):
        try:
            subprocess.run(["ya", "emit-to", "0", "app:theme"], check=True,
                           capture_output=True, text=True, timeout=5)
        except subprocess.CalledProcessError as error:
            detail = error.stderr.strip()
            # Yazi exposes errno only in its error text; use structured errors if added.
            if detail != "Cannot emit command: Connection refused (os error 111)":
                failed = True
                print(f"Failed: Yazi theme reload was not delivered: {detail or error}",
                      file=sys.stderr)
        except (OSError, subprocess.SubprocessError) as error:
            failed = True
            print(f"Failed: Yazi theme reload was not delivered: {error}", file=sys.stderr)
    if app in (None, "quickshell"):
        if os.environ.get("WAYLAND_DISPLAY") and os.environ.get("ICEWINE_THEME_FROM_SHELL") != "1":
            try:
                shell = subprocess.run(["qs", "ipc", "call", "theme", "refresh"],
                                       capture_output=True, text=True, timeout=10)
                if shell.returncode != 0 or not shell.stdout.strip().startswith("applied:"):
                    print("Failed: Quickshell palette refresh request was not confirmed.", file=sys.stderr)
                    failed = True
            except (OSError, subprocess.SubprocessError):
                print("Failed: Quickshell palette refresh request was not delivered.", file=sys.stderr)
                failed = True
    return failed


def dispatch(argv):
    if not argv or argv[0] not in {"init", "reset", "theme", "transparency", "autofullscreen", "apply"}:
        raise ValueError("Usage: icewine {init [APP]|reset [APP]|theme [THEME_ID]|transparency [off|low|med|high]|autofullscreen [on|off]}")
    command, *args = argv
    if len(args) > (0 if command == "apply" else 1):
        raise ValueError("unexpected arguments")
    app = args[0] if command in {"init", "reset"} and args else None
    if app and app not in APPS:
        raise ValueError(f"unsupported app: {app}; choose {', '.join(APPS)}")
    config = xdg("XDG_CONFIG_HOME", ".config")
    state = xdg("XDG_STATE_HOME", ".local/state") / "icewine"
    if command in {"init", "reset"}:
        implementation_preflight(os.environ.get("ICEWINE_DEFAULT_FILES"), config, state, app)
    if command == "init":
        state.mkdir(parents=True, exist_ok=True)
    if command == "autofullscreen":
        path = state / "autofullscreen"
        value = args[0] if args else (path.read_text(encoding="utf-8").strip() if path.exists() else "off")
        if value not in {"on", "off"}:
            raise ValueError("invalid autofullscreen setting; choose on or off")
        if args:
            atomic_text(path, value + "\n")
            if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
                try:
                    subprocess.run(["hyprctl", "reload"], check=True, timeout=10)
                except (OSError, subprocess.SubprocessError) as error:
                    raise ValueError(f"autofullscreen saved, but Hyprland reload failed: {error}") from error
            else:
                print("Pending: autofullscreen takes effect at next Hyprland login.")
        print(f"Autofullscreen: {value}")
        return 0
    assets = Path(os.environ.get("ICEWINE_THEME_ASSETS", "/usr/share/icewine"))
    themes = installed(assets)
    if DEFAULT not in themes:
        raise ValueError("Tokyo Night assets are missing")
    if command == "transparency" and not args:
        print(f"Transparency: {transparency_level(state)} (off, low, med, high)")
        return 0
    if command == "theme" and args == ["status"]:
        if os.environ.get("WAYLAND_DISPLAY"):
            try:
                result = subprocess.run(["qs", "ipc", "call", "theme", "status"],
                                        check=True, capture_output=True, text=True, timeout=10)
                print(result.stdout.strip())
                return 0
            except (OSError, subprocess.SubprocessError):
                pass
        theme_id, policy = effective(state, themes)
        print(f"Saved: {theme_id}" + (" (Nix policy)" if policy else ""))
        print("Pending: Quickshell is unavailable; live application status is unknown.")
        return 0
    if command == "theme" and not args:
        theme_id, policy = effective(state, themes)
        print("Installed: " + ", ".join(sorted(themes)))
        print(f"Effective: {theme_id}" + (" (Nix policy)" if policy else ""))
        print("Apps: " + ", ".join(APPS))
        return 0
    if command == "theme":
        requested = args[0]
        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", requested) or requested not in themes:
            raise ValueError(f"theme is not installed: {requested}")
        if os.environ.get("WAYLAND_DISPLAY"):
            try:
                result = subprocess.run(["qs", "ipc", "call", "theme", "select", requested],
                                        capture_output=True, text=True, timeout=10)
                if result.returncode == 0:
                    answer = result.stdout.strip()
                    if answer.startswith(("pending:", "saved:")):
                        print(answer)
                        return 0
                    if answer.startswith("failed:"):
                        raise ValueError(answer)
            except (OSError, subprocess.SubprocessError):
                pass
            print("Pending: Quickshell is unavailable; saving selection for next login.", file=sys.stderr)
        atomic_text(state / "theme", requested + "\n")
    elif command == "transparency":
        if args[0] not in TRANSPARENCY:
            raise ValueError("invalid transparency; choose off, low, med or high")
        atomic_text(state / "transparency", args[0] + "\n")
    elif command == "reset":
        state.mkdir(parents=True, exist_ok=True)
        backup_owned(config, state, [config / relative for relative in owned(app)
                                     if (config / relative).exists() or (config / relative).is_symlink()])
        if app is None:
            (state / "theme").unlink(missing_ok=True)
            (state / "transparency").unlink(missing_ok=True)
            (state / "autofullscreen").unlink(missing_ok=True)
    theme_id, policy = effective(state, themes)
    level = transparency_level(state)
    files = render_theme(assets, themes[theme_id], level)
    gtk_enabled = os.environ.get("ICEWINE_GTK_ENABLE", "true") != "false"
    install_links(config, state, False, app, install=False)
    gtk_complete = True
    if not gtk_enabled and app in (None, "gtk"):
        gtk_complete = retire_gtk_theme(config, state, themes)
    if gtk_enabled and app in (None, "gtk"):
        try:
            install_gtk_theme(config, theme_id)
        except (OSError, ValueError) as error:
            print(f"Pending: GTK custom CSS theme could not be installed: {error}", file=sys.stderr)
    publish(config, files)
    sddm_file = os.environ.get("ICEWINE_SDDM_THEME_FILE")
    if sddm_file:
        try:
            atomic_text(Path(sddm_file), f"[General]\ntheme={theme_id}\n", 0o644)
        except OSError as error:
            print(f"Pending: SDDM colours will not update: {error}", file=sys.stderr)
    if command in {"init", "reset"}:
        install_defaults(os.environ.get("ICEWINE_DEFAULT_FILES"), config,
                         xdg("XDG_DATA_HOME", ".local/share"), state, command == "reset", app)
    if command in {"init", "reset", "theme", "transparency", "apply"}:
        install_links(config, state, command == "reset", app, install=command != "apply")
    if gtk_enabled and app in (None, "gtk"):
        install_flatpak_theme(state, theme_id, files)
        appearance = json.loads(themes[theme_id].read_text(encoding="utf-8"))["appearance"]
        gtk_complete = sync_gtk_settings(theme_id, appearance, state)
    print(f"Theme: {theme_id}" + (" (Nix policy overrides CLI selection)" if policy else "") + f" · Transparency: {level}")
    if command in {"theme", "reset", "transparency", "apply"}:
        return int(reload_session(config, app if command == "reset" else None) or not gtk_complete)
    return 0


def main(argv):
    if argv and argv[0] in {"init", "reset"}:
        state = xdg("XDG_STATE_HOME", ".local/state") / "icewine"
        state.mkdir(parents=True, exist_ok=True)
        # Ponytail: one lock serialises init/reset, including backups; split by root if contention matters.
        fd = os.open(state / "defaults.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "r+") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            return dispatch(argv)
    return dispatch(argv)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, ValueError) as error:
        print(f"icewine: {error}", file=sys.stderr)
        sys.exit(1)
