#!/usr/bin/env bash

usage() {
    cat >&2 <<'EOF'
Usage: icewine {init [APP]|reset [APP]|theme [THEME_ID]|transparency [off|low|med|high]|autofullscreen [on|off]|wallpaper IMAGE}
EOF
}

case ${1:-} in
    init|reset|theme|transparency|autofullscreen)
        exec icewine-theme "$@"
        ;;
    wallpaper)
        shift
        exec icewine-wallpaper "$@"
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 2
        ;;
esac
