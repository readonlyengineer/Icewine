#!/usr/bin/env bash

usage() {
    cat >&2 <<'EOF'
Usage: icewine {init|reset|theme [THEME_ID]|wallpaper IMAGE}
EOF
}

case ${1:-} in
    init|reset|theme)
        exec icewine-theme "$@"
        ;;
    wallpaper)
        shift
        exec icewine-wallpaper "$@"
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 2
        ;;
esac
