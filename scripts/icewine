#!/usr/bin/env bash

usage() {
    cat >&2 <<'EOF'
Usage: icewine [manage|theme [THEME_ID|status]|transparency [off|low|med|high]|layout [scrolling|dwindle|master|monocle]|autofullscreen [on|off]|wallpaper IMAGE]
Run icewine without arguments to open the manager.
EOF
}

case ${1:-} in
    "")
        exec icewine-manage
        ;;
    manage)
        shift
        exec icewine-manage "$@"
        ;;
    theme|transparency|autofullscreen|layout)
        exec icewine-theme "$@"
        ;;
    wallpaper)
        shift
        exec icewine-wallpaper "$@"
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 2
        ;;
esac
