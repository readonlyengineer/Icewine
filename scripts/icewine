#!/usr/bin/env bash

usage() {
    cat >&2 <<'EOF'
Usage: icewine {manage|theme [THEME_ID|status]|transparency [off|low|med|high]|autofullscreen [on|off]|wallpaper IMAGE}
EOF
}

case ${1:-} in
    manage)
        shift
        exec icewine-manage "$@"
        ;;
    theme|transparency|autofullscreen)
        exec icewine-theme "$@"
        ;;
    wallpaper)
        shift
        exec icewine-wallpaper "$@"
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage
        exit 2
        ;;
esac
