#!/usr/bin/env bash
set -euo pipefail

drm_root=${1:-/sys/class/drm}

for status in "$drm_root"/card*-*/status; do
    [[ -r "$status" && "$(<"$status")" == connected ]] || continue

    connector=${status%/status}
    decoded= edid=
    if [[ -r "$connector/edid" ]]; then
        decoded=$(edid-decode "$connector/edid" 2>/dev/null) || decoded=
        edid=$(od -An -v -tx1 "$connector/edid" | tr -d ' \n') || edid=
    fi

    hdr=false
    [[ "$decoded" == *"SMPTE ST2084"* ]] && hdr=true

    vrr=false
    if [[ "$decoded" == *"Adaptive-Sync Data Block"* \
        || "$decoded" == *"FreeSync"* \
        || "$decoded" == *"VRRmin:"* \
        || ("$decoded" == *"Vendor-Specific Data Block (AMD)"* \
            && "$decoded" == *"Minimum Refresh Rate:"*) ]]; then
        vrr=true
    fi

    name=${connector##*/}
    printf '%s\t%s\t%s\t%s\n' "${name#*-}" "$hdr" "$vrr" "$edid"
done
