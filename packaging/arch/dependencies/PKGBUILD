# Optional private controller-idle helper; the OSK uses distro wtype.
pkgbase=icewine-handheld-dependencies
pkgname=(icewine-controller-idle)
pkgver=1.43.1
pkgrel=1
arch=(x86_64)
license=(GPL-2.0-only)
makedepends=(meson ninja pkgconf wayland wayland-protocols systemd)
source=("wljoywake-0.3.tar.gz::https://github.com/nowrep/wljoywake/archive/refs/tags/v0.3.tar.gz")
sha256sums=(d02d0d20c6b7712a17c4891b0c28e562d6f9021de28225979453242292be8230)

build() {
  meson setup --prefix=/usr --buildtype=release "$srcdir/wljoywake-0.3" "$srcdir/idle-build"
  meson compile -C "$srcdir/idle-build"
}

package_icewine-controller-idle() {
  pkgdesc='Private controller idle inhibitor for Icewine Handheld'
  depends=(wayland systemd-libs glibc)
  install -Dm755 "$srcdir/idle-build/wljoywake" "$pkgdir/usr/lib/icewine/wljoywake"
}
