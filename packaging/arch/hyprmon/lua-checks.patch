+func TestLuaSavePreservesManagedFiles(t *testing.T) {
+	for _, tc := range []struct {
+		name           string
+		importPresent  bool
+		managedSidecar bool
+		wantError      bool
+	}{
+		{"managed-main-writable-sidecar", true, false, false},
+		{"managed-main-and-sidecar", true, true, true},
+		{"managed-main-missing-import", false, false, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			dir := t.TempDir()
+			mainPath := filepath.Join(dir, "hyprland.lua")
+			mainTarget := filepath.Join(dir, "managed-main")
+			input := "-- declarative main\n"
+			if tc.importPresent {
+				input += "require(\"hyprmon\")\n"
+			}
+			if err := os.WriteFile(mainTarget, []byte(input), 0444); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.Symlink(mainTarget, mainPath); err != nil {
+				t.Fatal(err)
+			}
+			sidecarPath := filepath.Join(dir, "hyprmon.lua")
+			sidecarTarget := sidecarPath
+			const sidecarInput = "-- declarative monitor settings\n"
+			if tc.managedSidecar {
+				sidecarTarget = filepath.Join(dir, "managed-sidecar")
+				// Home Manager can insert another symlink before the store file.
+				link := filepath.Join(dir, "home-manager-sidecar")
+				if err := os.Symlink(sidecarTarget, link); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.Symlink(link, sidecarPath); err != nil {
+					t.Fatal(err)
+				}
+			}
+			mode := os.FileMode(0600)
+			if tc.managedSidecar {
+				mode = 0444
+			}
+			if err := os.WriteFile(sidecarTarget, []byte(sidecarInput), mode); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("HYPRLAND_CONFIG", mainPath)
+			err := writeConfig([]Monitor{{Name: "DP-1", Active: false}})
+			if (err != nil) != tc.wantError {
+				t.Fatalf("Save error = %v, want error %v", err, tc.wantError)
+			}
+			got, err := os.ReadFile(mainTarget)
+			if err != nil || string(got) != input {
+				t.Fatalf("main changed: %q, %v", got, err)
+			}
+			if link, err := os.Readlink(mainPath); err != nil || link != mainTarget {
+				t.Fatalf("main symlink changed: %q, %v", link, err)
+			}
+			got, err = os.ReadFile(sidecarPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if tc.wantError && string(got) != sidecarInput {
+				t.Fatalf("failed Save changed sidecar: %q", got)
+			}
+			if !tc.wantError && !strings.Contains(string(got), `hl.monitor({ output = "DP-1", disabled = true })`) {
+				t.Fatalf("writable sidecar not saved: %q", got)
+			}
+			if tc.managedSidecar {
+				if _, err := os.Readlink(sidecarPath); err != nil {
+					t.Fatalf("sidecar symlink replaced: %v", err)
+				}
+			}
+		})
+	}
+}
