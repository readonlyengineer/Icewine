+// Exercise actual IPC dispatch without talking to a compositor.
+func TestApplySaveReloadWithFakeHyprctl(t *testing.T) {
+	sh, err := exec.LookPath("sh")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, extension := range []string{"lua", "conf"} {
+		t.Run(extension, func(t *testing.T) {
+			dir := t.TempDir()
+			logPath := filepath.Join(dir, "calls")
+			fake := "#!" + sh + "\nprintf '%s\n' \"$@\" >> \"$HYPRMON_TEST_LOG\"\n"
+			if err := os.WriteFile(filepath.Join(dir, "hyprctl"), []byte(fake), 0700); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("PATH", dir+string(os.PathListSeparator)+os.Getenv("PATH"))
+			t.Setenv("HYPRMON_TEST_LOG", logPath)
+			configPath := filepath.Join(dir, "hyprland."+extension)
+			input := "-- unrelated user setting\nrequire(\"hyprmon\")\n"
+			if extension == "conf" {
+				input = "# unrelated user setting\n"
+			}
+			if err := os.WriteFile(configPath, []byte(input), 0600); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("HYPRLAND_CONFIG", configPath)
+			monitor := Monitor{Name: "DP-1", PxW: 1920, PxH: 1080, Hz: 60, Scale: 1}
+			if err := applyMonitor(monitor); err != nil {
+				t.Fatal(err)
+			}
+			monitor.Active = true
+			if err := applyMonitor(monitor); err != nil {
+				t.Fatal(err)
+			}
+			if err := writeConfig([]Monitor{monitor}); err != nil {
+				t.Fatal(err)
+			}
+			if err := reloadConfig(); err != nil {
+				t.Fatal(err)
+			}
+			calls, err := os.ReadFile(logPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := "keyword\nmonitor\nDP-1,disable\nkeyword\nmonitor\nDP-1,1920x1080@60.00,0x0,1.00\nreload\n"
+			if extension == "lua" {
+				want = "eval\nhl.monitor({ output = \"DP-1\", disabled = true })\neval\nhl.monitor({ output = \"DP-1\", mode = \"1920x1080@60.00\", position = \"0x0\", scale = 1.00, disabled = false })\nreload\n"
+			}
+			if string(calls) != want {
+				t.Fatalf("IPC calls = %q, want %q", calls, want)
+			}
+			entry, err := os.ReadFile(configPath)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if extension == "lua" && string(entry) != input {
+				t.Fatalf("save changed unrelated Lua entry: %q", entry)
+			}
+		})
+	}
+}
