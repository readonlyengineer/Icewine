+// Bounded diagnostic for issue #92: asynchronous Save commands may overlap.
+// A passing run cannot establish absence of filesystem interleavings.
+func TestConcurrentLuaSavesPreserveEntry(t *testing.T) {
+	dir := t.TempDir()
+	configPath := filepath.Join(dir, "hyprland.lua")
+	t.Setenv("HYPRLAND_CONFIG", configPath)
+	input := "-- unrelated user configuration\nrequire(\"hyprmon\")\n"
+	monitors := []Monitor{{Name: "DP-1", Active: true, PxW: 1920, PxH: 1080, Hz: 60, Scale: 1}}
+	for round := 0; round < 64; round++ {
+		// Keep the original include-present reproduction and cover first saves too.
+		input := input
+		if round%2 == 1 {
+			input = "-- unrelated user configuration\n"
+		}
+		want := ensureHyprmonLuaRequire(input)
+		if err := os.WriteFile(configPath, []byte(input), 0600); err != nil {
+			t.Fatal(err)
+		}
+		var workers sync.WaitGroup
+		start := make(chan struct{})
+		errors := make(chan error, 32)
+		for i := 0; i < 32; i++ {
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				<-start
+				errors <- writeConfig(monitors)
+			}()
+		}
+		close(start)
+		workers.Wait()
+		close(errors)
+		for err := range errors {
+			if err != nil {
+				t.Fatal(err)
+			}
+		}
+		entry, err := os.ReadFile(configPath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(entry) != want {
+			t.Fatalf("concurrent saves changed Lua entry in round %d: got %q, want %q", round, entry, want)
+		}
+		sidecar, err := os.ReadFile(filepath.Join(dir, "hyprmon.lua"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !strings.Contains(string(sidecar), `hl.monitor({ output = "DP-1", mode = "1920x1080@60.00", position = "0x0", scale = 1.00, disabled = false })`) {
+			t.Fatalf("concurrent saves damaged sidecar in round %d: %q", round, sidecar)
+		}
+	}
+}
