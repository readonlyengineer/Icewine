From 43f06d7e6d144df2d200914fdc695d74f11ed721 Mon Sep 17 00:00:00 2001
From: Eran Sandler <eran@sandler.co.il>
Date: Tue, 9 Jun 2026 21:14:09 -0700
Subject: [PATCH] fix: replace constant fmt.Sprintf with string literal in Lua
 writer

golangci-lint (gosimple S1039) failed CI on main: the Lua monitor
writer used fmt.Sprintf("disabled = false") with no format directives.
Use the plain string literal instead.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 hyprland.go | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/hyprland.go b/hyprland.go
index bf978d2..6cf18bd 100644
--- a/hyprland.go
+++ b/hyprland.go
@@ -575,7 +575,7 @@ func generateLuaMonitorRule(m Monitor) string {
 		fmt.Sprintf("mode = %s", luaString(fmt.Sprintf("%dx%d@%.2f", m.PxW, m.PxH, m.Hz))),
 		fmt.Sprintf("position = %s", luaString(fmt.Sprintf("%dx%d", m.X, m.Y))),
 		fmt.Sprintf("scale = %.2f", m.Scale),
-		fmt.Sprintf("disabled = false"),
+		"disabled = false",
 	)
 
 	if m.IsMirrored && m.MirrorSource != "" {
