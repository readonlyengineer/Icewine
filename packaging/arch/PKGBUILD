# Build from an Icewine source archive; see README.md in this directory.
pkgbase=icewine
pkgname=(icewine icewine-cachyos-fish icewine-sddm)
pkgver=0.1
pkgrel=1
arch=(x86_64)
pkgdesc='Icewine Hyprland desktop session'
license=(custom)
makedepends=(python)
options=(!strip)
_plugins=4dc7f1b6458c2578f4494f10d468c68c1082214f
source=(icewine.tar.gz "yazi-plugins-${_plugins}.tar.gz::https://codeload.github.com/yazi-rs/plugins/tar.gz/${_plugins}")
# The local development archive is generated by the user; upstream is immutable.
sha256sums=(SKIP 0e65f2858d06c0889a652be1c400c2df02f0cbda782dc452da52dd0cd6e27867)

build() {
  cd "$srcdir/icewine"
  python packaging/arch/sddm-palette.py > "$srcdir/Palette.qml"
}

package_icewine() {
  depends=(hyprland quickshell uwsm hyprshutdown hyprpolkitagent hypridle
    xdg-desktop-portal-hyprland xdg-desktop-portal-gtk qt6-svg qt6-wayland qt6-virtualkeyboard
    bash coreutils grep glib2 jq nano systemd util-linux python python-vdf procps-ng
    xdg-utils xdg-user-dirs hyprshot hyprpicker libnotify libcanberra brightnessctl ddcutil v4l-utils
    pam pambase polkit upower power-profiles-daemon pipewire wireplumber
    ttf-dejavu ttf-jetbrains-mono-nerd noto-fonts-emoji adwaita-icon-theme adwaita-cursors
    papirus-icon-theme dconf gsettings-desktop-schemas firefox neovim 'yazi>=26.5.6'
    ffmpegthumbnailer 7zip gvfs udisks2 steam gamescope)
  optdepends=('kitty: terminal emulator' 'alacritty: alternative terminal emulator'
    'networkmanager: network controls' 'bluez: Bluetooth controls'
    'sudo: upstream Yazi mount authorization fallback')
  backup=(etc/pam.d/icewine)
  cd "$srcdir/icewine"
  local share="$pkgdir/usr/share/icewine" defaults="$pkgdir/usr/share/icewine/defaults/config"
  install -d "$share" "$defaults" "$share/defaults/data" "$pkgdir/usr/bin" "$pkgdir/usr/lib/icewine"
  install -d "$share/defaults/data/applications"
  printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=uuctl' 'NoDisplay=true' 'Hidden=true' > "$share/defaults/data/applications/uuctl.desktop"
  cp -r theme/assets "$share/theme"
  install -Dm644 theme/assets/flower-branch.png "$share/defaults/data/wallpapers/default.jpg"
  install -d "$share/quickshell"
  cp -r quickshell/{modules,adapters,theme} "$share/quickshell/"
  cp quickshell/Desktop.qml "$share/quickshell/"
  install -d "$share/hyprland"
  cp hyprland/icewine.lua "$share/hyprland/"
  cp -r hyprland/modules "$share/hyprland/"
  cp -r kitty nvim gtk hypridle session "$share/"
  # Native implementation contains no Bash preset or Nix-generated wrappers.
  cp scripts/theme scripts/wallpaper "$pkgdir/usr/lib/icewine/"
  install -m755 scripts/icewine "$pkgdir/usr/bin/icewine"
  install -m755 packaging/arch/command "$pkgdir/usr/lib/icewine/command"
  for name in theme wallpaper terminal terminal-exec browser editor file-manager steam; do
    ln -s ../lib/icewine/command "$pkgdir/usr/bin/icewine-$name"
  done
  install -m755 packaging/arch/session "$pkgdir/usr/bin/icewine-session"
  install -m755 quickshell/tools/steam-shortcuts "$pkgdir/usr/bin/icewine-steam-shortcuts"
  install -m755 quickshell/tools/probe-monitor-capabilities "$pkgdir/usr/bin/icewine-monitor-capabilities"
  install -m755 quickshell/tools/monitor-brightness "$pkgdir/usr/bin/icewine-monitor-brightness"
  for dir in hypr quickshell/config kitty nvim uwsm gtk-3.0 gtk-4.0 yazi/plugins; do install -d "$defaults/$dir"; done
  cp hyprland/hyprland.lua "$defaults/hypr/"
  cp quickshell/shell.qml "$defaults/quickshell/"
  cp quickshell/config/{Settings.qml,qmldir} "$defaults/quickshell/config/"
  cp kitty/kitty.conf "$defaults/kitty/"
  cp nvim/init.lua "$defaults/nvim/"
  cp -r "$srcdir/plugins-$_plugins/mount.yazi" "$defaults/yazi/plugins/"
  printf '%s\n' 'source = hypridle-icewine/defaults.conf' > "$defaults/hypr/hypridle.conf"
  for version in 3 4; do
    local css=gtk.css
    [[ $version == 4 ]] && css=gtk4.css
    printf '%s\n' '@import url("icewine/defaults.css");' "@import url(\"../icewine/current/$css\");" '/* Add your overrides below. */' > "$defaults/gtk-$version.0/gtk.css"
    ln -s /usr/share/icewine/gtk "$defaults/gtk-$version.0/icewine"
  done
  ln -s /usr/share/icewine/hyprland "$defaults/hypr/icewine"
  ln -s /usr/share/icewine/hypridle "$defaults/hypr/hypridle-icewine"
  ln -s /usr/share/icewine/quickshell "$defaults/quickshell/icewine"
  ln -s /usr/share/icewine/kitty "$defaults/kitty/icewine"
  ln -s /usr/share/icewine/nvim "$defaults/nvim/icewine"
  # Kitty's packaged implementation expects this existing shared filename.
  cp theme/assets/templates/kitty-base.conf "$share/kitty/defaults.conf"
  install -Dm644 packaging/arch/env "$pkgdir/usr/share/uwsm/env-icewine"
  local ids='' file
  for file in theme/assets/themes/*.json; do
    file=${file##*/}; ids+=${ids:+:}${file%.json}
  done
  printf 'export ICEWINE_THEME_IDS=%s\n' "$ids" >> "$pkgdir/usr/share/uwsm/env-icewine"
  install -Dm644 packaging/arch/icewine.desktop "$pkgdir/usr/share/wayland-sessions/icewine.desktop"
  install -Dm644 packaging/arch/autostart.desktop "$pkgdir/etc/xdg/autostart/icewine.desktop"
  install -Dm644 packaging/arch/icewine.pam "$pkgdir/etc/pam.d/icewine"
  install -Dm644 packaging/arch/portals.conf "$pkgdir/usr/share/xdg-desktop-portal/icewine-portals.conf"
  for unit in packaging/arch/*.service packaging/arch/*.target packaging/arch/*.path; do
    install -Dm644 "$unit" "$pkgdir/usr/lib/systemd/user/${unit##*/}"
  done
  install -Dm644 packaging/arch/steam-gamescope.desktop "$pkgdir/usr/share/applications/steam-gamescope.desktop"
  install -Dm644 theme/assets/themes/CATPPUCCIN-LICENSE "$pkgdir/usr/share/licenses/icewine/CATPPUCCIN-LICENSE"
  install -Dm644 "$srcdir/plugins-$_plugins/mount.yazi/LICENSE" "$pkgdir/usr/share/licenses/icewine/YAZI-MOUNT-LICENSE"
}

package_icewine-cachyos-fish() {
  pkgdesc='Optional Icewine Fish prompt and greeting for CachyOS'
  depends=(icewine fish starship fastfetch)
  install -Dm644 "$srcdir/icewine/packaging/arch/icewine.fish" "$pkgdir/usr/share/fish/vendor_conf.d/icewine.fish"
  install -Dm644 "$srcdir/icewine/packaging/arch/fish_greeting.fish" "$pkgdir/usr/share/fish/vendor_functions.d/fish_greeting.fish"
}

package_icewine-sddm() {
  pkgdesc='Optional Icewine SDDM theme (manual selection)'
  depends=(icewine sddm qt6-declarative qt6-virtualkeyboard)
  local theme="$pkgdir/usr/share/sddm/themes/icewine"
  cd "$srcdir/icewine"
  install -d "$theme/modules" "$theme/theme"
  cp sddm/{Main.qml,metadata.desktop} "$theme/"
  cp quickshell/modules/{WinterScreen.qml,WinterModel.js} "$theme/modules/"
  cp "$srcdir/Palette.qml" "$theme/theme/Palette.qml"
  printf '%s\n' 'singleton Palette 1.0 Palette.qml' > "$theme/theme/qmldir"
}
