[Unit]
Description=Icewine desktop shell
PartOf=icewine-session.target graphical-session.target
After=graphical-session.target
Conflicts=mako.service

[Service]
Environment=QML_IMPORT_PATH=/usr/share/icewine/quickshell
Environment=KIRIGAMI_PLATFORM_THEME=org.kde.breeze
ExecStart=/usr/bin/icewine-shell
ExecStopPost=-/usr/bin/icewine-inputplumber-intercept overlay
Restart=on-failure
