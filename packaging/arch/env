. /usr/share/icewine/session/env
export ICEWINE_KITTY_PRESET=false
if command -v kitty >/dev/null 2>&1; then export ICEWINE_KITTY_PRESET=true; fi
export ICEWINE_STEAM_CLIENT=none ICEWINE_STEAM_ENABLED=false ICEWINE_GAMESCOPE_ENABLED=false ICEWINE_HANDHELD_ENABLED=false
if [ "${ICEWINE_ONBOARDING_STAGE:-}" != session ]; then
    selections=$(icewine-manage-backend state) || return 1
    case " $selections " in
      *" steam=native "*) export ICEWINE_STEAM_CLIENT=native ICEWINE_STEAM_ENABLED=true ;;
      *" steam=flatpak "*) export ICEWINE_STEAM_CLIENT=flatpak ICEWINE_STEAM_ENABLED=true ;;
    esac
    case " $selections " in *" gamescope=true "*) export ICEWINE_GAMESCOPE_ENABLED=true ;; esac
    case " $selections " in *" handheld=true "*) export ICEWINE_HANDHELD_ENABLED=true ;; esac
fi
export ICEWINE_BATTERY_ENABLED=${ICEWINE_BATTERY_ENABLED:-true}
export QT_IM_MODULE=qtvirtualkeyboard
export QT_VIRTUALKEYBOARD_DESKTOP_DISABLE=1
