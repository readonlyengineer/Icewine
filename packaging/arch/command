#!/usr/bin/env bash
set -e
case ${0##*/} in
  icewine-editor)
    selections=$(icewine-manage-backend state)
    [[ " $selections " == *" texteditor=true "* ]] || { echo 'Terminal Editor is disabled in Utilities' >&2; exit 1; }
    export NVIM_APPNAME=icewine-nvim
    exec nvim -u /usr/share/icewine/editor/init.lua "$@" ;;
  icewine-shell)
    exec qs "$@" ;;
  icewine-manage-backend)
    export ICEWINE_BINDINGS_FILE=/usr/share/icewine/hyprland/modules/Bindings.tsv
    export ICEWINE_THEME_ASSETS=/usr/share/icewine/theme
    export ICEWINE_DEFAULT_FILES=/usr/share/icewine/defaults
    exec python3 /usr/lib/icewine/manage "$@" ;;
  icewine-theme)
    export ICEWINE_THEME_ASSETS=/usr/share/icewine/theme
    export ICEWINE_DEFAULT_FILES=/usr/share/icewine/defaults
    export ICEWINE_GTK_ENABLE=false
    selections=${XDG_STATE_HOME:-$HOME/.local/state}/icewine/manage.json
    if [[ -f $selections ]]; then export ICEWINE_GTK_ENABLE=$(jq -r '.desktop' "$selections"); fi
    exec python3 /usr/lib/icewine/theme "$@" ;;
  icewine-wallpaper)
    export ICEWINE_THEME_ASSETS=/usr/share/icewine/theme
    export ICEWINE_WALLPAPER_VALIDATOR=/usr/share/icewine/quickshell/modules/WallpaperValidator.qml
    exec python3 /usr/lib/icewine/wallpaper "$@" ;;
  icewine-clipboard)
    exec python3 /usr/lib/icewine/clipboard "$@" ;;
  icewine-ssh)
    export ICEWINE_SSH_ASKPASS=/usr/bin/icewine-ssh
    exec python3 /usr/lib/icewine/ssh "$@" ;;
  icewine-inputplumber-intercept)
    if [[ ${1:-} != device ]]; then
      if [[ -n ${ICEWINE_HANDHELD_ENABLED+x} ]]; then
        [[ $ICEWINE_HANDHELD_ENABLED == true ]] || exit 1
      else
        selections=$(icewine-manage-backend state)
        [[ " $selections " == *" handheld=true "* ]] || exit 1
      fi
    fi
    export ICEWINE_INPUTPLUMBER_PROFILE_DIR=/usr/share/icewine/inputplumber
    exec bash /usr/lib/icewine/inputplumber-intercept.sh "$@" ;;
  icewine-inputplumber-hyprland|icewine-inputplumber-restore|icewine-keyboard-toggle)
    export ICEWINE_INPUTPLUMBER_PROFILE_DIR=/usr/share/icewine/inputplumber
    script=${0##*/}; script=${script#icewine-}
    exec bash "/usr/lib/icewine/$script.sh" "$@" ;;
  icewine-steam)
    [[ ${ICEWINE_STEAM_ENABLED:-true} != false ]] || exit 1
    if [[ -n ${ICEWINE_STEAM_CLIENT+x} ]]; then
      client=$ICEWINE_STEAM_CLIENT
      handheld=${ICEWINE_HANDHELD_ENABLED:-false}
    else
      selections=$(icewine-manage-backend state)
      client=none; handheld=false
      case " $selections " in *" steam=native "*) client=native ;; *" steam=flatpak "*) client=flatpak ;; esac
      case " $selections " in *" handheld=true "*) handheld=true ;; esac
    fi
    [[ $handheld == true || $handheld == false ]] || exit 1
    [[ $handheld != true || $client == native ]] || exit 1
    case "$client" in
      flatpak) exec flatpak run com.valvesoftware.Steam "$@" ;;
      native)
        [[ $handheld != true ]] || set -- -gamepadui "$@"
        exec steam "$@" ;;
      *) exit 1 ;;
    esac ;;
  *) exit 2 ;;
esac
