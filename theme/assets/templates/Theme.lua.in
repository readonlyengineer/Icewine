hl.config({ general = { col = {
  active_border = { colors = { "rgba(@highlight@ee)", "rgba(@secondaryHighlight@ee)" }, angle = 45 },
  inactive_border = "rgba(@background@aa)",
} } })
hl.config({ decoration = { inactive_opacity = @inactiveOpacity@ } })

if os.getenv("ICEWINE_KITTY_PRESET") ~= "false" then
  -- Keep Kitty's terminal alpha consistent on focus changes.
  -- Use the shared border size and palette colours.
  hl.window_rule({
    name = "kitty-background-opacity",
    match = { class = "^kitty$" },
    opacity = "1.0 override 1.0 override 1.0 override",
  })
end
