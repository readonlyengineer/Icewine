# vim:ft=kitty

## name: Icewine
## license: MIT
## author: Folke Lemaitre
## upstream: generated by Icewine modules/terminal.nix

background_opacity @kittyOpacity@

background #@terminalBackground@
foreground #@foreground@
selection_background #@selection@
selection_foreground #@foreground@
url_color #@info@
cursor #@foreground@
cursor_text_color #@background@

# Tabs
active_tab_background #@highlight@
active_tab_foreground #@backgroundDark@
inactive_tab_background #@surface@
inactive_tab_foreground #@mutedAlt@
#tab_bar_background #@backgroundDark@

# Windows
active_border_color #@highlight@
inactive_border_color #@border@

# ANSI 0-15 and extended 16-17 retain their existing colours. Further slots
# follow stable Icewine roles, including upstream variants where available.
@terminalColors@
