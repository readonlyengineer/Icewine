# Icewine @themeId@
theme[main_bg]="#@background@"
theme[main_fg]="#@foreground@"
theme[title]="#@foreground@"
theme[hi_fg]="#@highlight@"
theme[selected_bg]="#@selection@"
theme[selected_fg]="#@foreground@"
theme[inactive_fg]="#@muted@"
theme[graph_text]="#@foregroundDark@"
theme[meter_bg]="#@surface@"
theme[proc_misc]="#@secondaryHighlight@"
theme[cpu_box]="#@highlight@"
theme[mem_box]="#@success@"
theme[net_box]="#@info@"
theme[proc_box]="#@secondaryHighlight@"
theme[div_line]="#@border@"
theme[temp_start]="#@success@"
theme[temp_mid]="#@warning@"
theme[temp_end]="#@error@"
theme[cpu_start]="#@success@"
theme[cpu_mid]="#@warning@"
theme[cpu_end]="#@error@"
theme[free_start]="#@surface@"
theme[free_mid]="#@green@"
theme[free_end]="#@greenBright@"
theme[cached_start]="#@surface@"
theme[cached_mid]="#@blue@"
theme[cached_end]="#@blueBright@"
theme[available_start]="#@surface@"
theme[available_mid]="#@yellow@"
theme[available_end]="#@yellowBright@"
theme[used_start]="#@surface@"
theme[used_mid]="#@red@"
theme[used_end]="#@redBright@"
theme[download_start]="#@surface@"
theme[download_mid]="#@blue@"
theme[download_end]="#@blueBright@"
theme[upload_start]="#@surface@"
theme[upload_mid]="#@magenta@"
theme[upload_end]="#@magentaBright@"
theme[process_start]="#@success@"
theme[process_mid]="#@warning@"
theme[process_end]="#@error@"
theme[proc_pause_bg]="#@selection@"
theme[proc_follow_bg]="#@selection@"
theme[proc_banner_bg]="#@selection@"
theme[proc_banner_fg]="#@foreground@"
theme[followed_bg]="#@selection@"
theme[followed_fg]="#@foreground@"
