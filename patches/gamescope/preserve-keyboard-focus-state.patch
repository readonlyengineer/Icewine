+
+void wlserver_nested_keyboard_leave()
+{
+	assert( wlserver_is_lock_held() );
+	wlserver.nested_keyboard_focus = false;
+	wlr_seat_keyboard_notify_clear_focus( wlserver.wlr.seat );
+
+	wlr_keyboard *keyboard = wlserver.wlr.virtual_keyboard_device;
+	// Update the device only. This stub has no key-event forwarding listener.
+	while ( keyboard->num_keycodes )
+	{
+		wlr_keyboard_key_event event = {
+			.time_msec = 0,
+			.keycode = keyboard->keycodes[keyboard->num_keycodes - 1],
+			.update_state = false,
+			.state = WL_KEYBOARD_KEY_STATE_RELEASED,
+		};
+		wlr_keyboard_notify_key( keyboard, &event );
+	}
+	wlr_keyboard_notify_modifiers( keyboard, 0, 0, 0, 0 );
+	std::erase_if( wlserver.mapPressedHotkeyKeys, [keyboard]( const auto &entry ) {
+		return entry.first.first == keyboard;
+	} );
+}
+
+bool wlserver_nested_keyboard_enter( const uint32_t *keys, size_t count )
+{
+	assert( wlserver_is_lock_held() );
+	wlserver_nested_keyboard_leave();
+	if ( count > WLR_KEYBOARD_KEYS_CAP )
+	{
+		wl_log.errorf( "Host keyboard snapshot exceeds wlroots' key capacity" );
+		return false;
+	}
+
+	wlr_keyboard *keyboard = wlserver.wlr.virtual_keyboard_device;
+	for ( size_t i = 0; i < count; ++i )
+	{
+		wlr_keyboard_key_event event = {
+			.time_msec = 0,
+			.keycode = keys[i],
+			.update_state = false,
+			.state = WL_KEYBOARD_KEY_STATE_PRESSED,
+		};
+		wlr_keyboard_notify_key( keyboard, &event );
+	}
+	// wl_keyboard.enter is followed by modifiers. Restore focus with both.
+	return true;
+}
+
+bool wlserver_nested_keyboard_modifiers( xkb_keymap *keymap, const wlr_keyboard_modifiers *mods, bool enter )
+{
+	assert( wlserver_is_lock_held() );
+	wlr_keyboard *keyboard = wlserver.wlr.virtual_keyboard_device;
+	if ( !keymap || ( keyboard->keymap != keymap && !wlr_keyboard_set_keymap( keyboard, keymap ) ) )
+	{
+		wl_log.errorf( "Failed to install host keyboard keymap" );
+		wlserver_nested_keyboard_leave();
+		return false;
+	}
+	wlr_keyboard_notify_modifiers( keyboard, mods->depressed, mods->latched, mods->locked, mods->group );
+	wlr_seat_set_keyboard( wlserver.wlr.seat, keyboard );
+	if ( enter )
+	{
+		wlserver.nested_keyboard_focus = true;
+		if ( wlserver.kb_focus_surface )
+			wlserver_keyboardfocus( wlserver.kb_focus_surface, false );
+	}
+	else if ( wlserver.nested_keyboard_focus )
+		wlr_seat_keyboard_notify_modifiers( wlserver.wlr.seat, &keyboard->modifiers );
+	return true;
+}
+
+void wlserver_nested_key( uint32_t key, bool press, uint32_t time, bool hotkeys )
+{
+	assert( wlserver_is_lock_held() );
+	if ( !wlserver.nested_keyboard_focus )
+		return;
+	wlr_keyboard *keyboard = wlserver.wlr.virtual_keyboard_device;
+	bool handled = hotkeys && wlserver_process_hotkeys( keyboard, key, press );
+	bool wasForwarded = std::find( keyboard->keycodes,
+		keyboard->keycodes + keyboard->num_keycodes, key ) != keyboard->keycodes + keyboard->num_keycodes;
+	// A consumed press never enters client state. A previously forwarded press
+	// must still get its release, even when that release also completes a binding.
+	if ( ( press && handled ) || ( !press && !wasForwarded ) )
+	{
+		bump_input_counter();
+		return;
+	}
+	wlr_keyboard_key_event event = {
+		.time_msec = time,
+		.keycode = key,
+		.update_state = false, // Host modifier events are authoritative.
+		.state = press ? WL_KEYBOARD_KEY_STATE_PRESSED : WL_KEYBOARD_KEY_STATE_RELEASED,
+	};
+	wlr_keyboard_notify_key( keyboard, &event );
+	wlr_seat_set_keyboard( wlserver.wlr.seat, keyboard );
+	wlr_seat_keyboard_notify_key( wlserver.wlr.seat, time, key, event.state );
+	bump_input_counter();
 }
 
 void wlserver_key( uint32_t key, bool press, uint32_t time )
